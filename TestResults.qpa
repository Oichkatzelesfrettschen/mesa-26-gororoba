<?xml version="1.0" encoding="UTF-8"?>
<TestCaseResult CasePath="dEQP-VK.image.store.with_format.2d_array.r32_uint_single_layer" Version="0.3.4" CaseType="SelfValidate">
 <Section Name="comp" Description="Program: comp">
  <ShaderProgram LinkStatus="OK">
   <InfoLog></InfoLog>
   <ComputeShader CompileStatus="OK">
    <ShaderSource>#version 440

layout (local_size_x = 1, local_size_y = 1, local_size_z = 1) in;
layout (binding = 0, r32ui) writeonly uniform uimage2D u_image;
layout (binding = 1) readonly uniform Constants {
    int u_layerNdx;
};

void main (void)
{
    int gx = int(gl_GlobalInvocationID.x);
    int gy = int(gl_GlobalInvocationID.y);
    int gz = u_layerNdx;
    uvec4 storedColor = uvec4(gx^gy^gz, (63-gx)^gy^gz, gx^(63-gy)^gz, (63-gx)^(63-gy)^gz);
    imageStore(u_image, ivec2(gx, gy), storedColor);
}
</ShaderSource>
    <InfoLog></InfoLog>
</ComputeShader>
</ShaderProgram>
