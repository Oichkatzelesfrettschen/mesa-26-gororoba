#version 450
layout(local_size_x = 64) in;
layout(std430, set = 0, binding = 0) readonly buffer InputWords {
   uint in_words[];
};
layout(std430, set = 0, binding = 1) buffer OutputWords {
   uint out_words[];
};
void main() {
   uint i = gl_GlobalInvocationID.x;
   out_words[i + 1u] = in_words[i];
}
