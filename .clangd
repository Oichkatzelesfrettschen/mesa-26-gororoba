CompileFlags:
  # Repo-stable database refreshed by build-infra/scripts/refresh-clangd-db.sh
  # from the newest built profile (build/mesa-* or builddir*).  The per-file
  # flags already carry -Werror from the werror=true profiles, so clangd shows
  # real compiler warnings as errors.
  CompilationDatabase: build/clangd-db

Diagnostics:
  # The include-cleaner (UnusedIncludes / MissingIncludes) is an editor-only
  # heuristic separate from the compiler's -Werror.  Mesa's heavily transitive
  # headers make it fire constantly with false positives ("header X is not used
  # directly") on every edit -- pure noise that drowns the real diagnostics.
  # Suppress it; genuine warnings still surface via the database's -Werror flags.
  UnusedIncludes: None
  MissingIncludes: None
