# mesa-gororoba-asan: SCOPED ASan+UBSan r300 debug driver.  Maximal compile-time
# instrumentation (AddressSanitizer + UndefinedBehaviorSanitizer, live asserts,
# full -g3, frame pointers, -O1) repacked from the build-infra maximal profile
# 7_r300_full_asanubsan_max_debug.
#
# CRITICAL -- this is NOT a system driver and deliberately does the OPPOSITE of
# mesa-gororoba / mesa-gororoba-debug: it installs ONLY to /opt/mesa-26-gororoba-asan
# and does NOT symlink into /usr, does NOT provide/conflict/replace mesa, and does
# NOT drop an ld.so.conf path.  An ASan-instrumented libGL/libvulkan as the system
# Mesa aborts every GL/VK client ("ASan runtime does not come first in initial
# library list") -- it would brick the login session.  It is installable ALONGSIDE
# the release and debug drivers and is reached only through the run-wrapper
# mesa-26-gororoba-asan-run (LD_PRELOAD the ASan runtime, point the loaders at /opt).
#
# Build model: REPACK (same as mesa-gororoba-debug).  Build/refresh the maximal
# builddir, then this PKGBUILD stages it:
#   make rebuild-7_r300_full_asanubsan_max_debug_x86_64v1-clang22-distcc-cache
pkgname=mesa-gororoba-asan
pkgver=26.2.0
pkgrel=1
epoch=2
pkgdesc='Scoped ASan+UBSan r300 debug driver (NOT system Mesa): max-instrumentation r300 GL + r300vk ICD under /opt, run via mesa-26-gororoba-asan-run; for sanitizer-backed GPU RCA alongside the release/debug drivers'
arch=('x86_64')
url='https://github.com/Oichkatzelesfrettschen/mesa-26-gororoba'
license=('MIT')
# Runtime libs the instrumented driver links, plus clang for the ASan runtime the
# wrapper LD_PRELOADs (compiler-rt ships in clang) and the loaders it points at.
depends=(
  clang compiler-rt
  expat glibc libdrm libelf libgcc libglvnd libstdc++ libx11 libxcb libxext
  libxdamage libxshmfence libxxf86vm libva lm_sensors spirv-tools
  wayland zlib zstd vulkan-icd-loader libunwind valgrind
)
makedepends=(meson ninja)
# No system-driver metadata: no provides/conflicts/replaces.  This package owns
# only /opt/mesa-26-gororoba-asan + the run-wrapper; it never touches /usr, so it
# co-installs with stock mesa, mesa-gororoba, and mesa-gororoba-debug.
options=('!strip' '!lto' 'debug' 'staticlibs' '!buildflags')
source=('mesa-26-gororoba-asan-run')
sha256sums=('SKIP')

_prefix=/opt/mesa-26-gororoba-asan
_builddir="${GOROROBA_ASAN_BUILDDIR:-/home/eirikr/workspaces/mesa/mesa-26-gororoba/build/mesa-7_r300_full_asanubsan_max_debug_x86_64v1-clang22-distcc-cache}"
_srcroot="${GOROROBA_ASAN_SRCROOT:-/home/eirikr/workspaces/mesa/mesa-26-gororoba}"

package() {
  if [ ! -f "${_builddir}/build.ninja" ]; then
    echo "ERROR: maximal asan+ubsan builddir not found at ${_builddir}" >&2
    echo "       build it: make rebuild-7_r300_full_asanubsan_max_debug_x86_64v1-clang22-distcc-cache" >&2
    return 1
  fi
  # Stage the prebuilt /opt tree ONLY.  --no-rebuild: never recompile here.  The
  # builddir prefix is /opt/mesa-26-gororoba-asan (set by the profile install
  # prefix), so meson install lands the whole instrumented driver there.
  meson install -C "${_builddir}" --no-rebuild --destdir "${pkgdir}"

  # The only /usr file: the run-wrapper.  Everything else stays under /opt so the
  # system Mesa is untouched.
  install -Dm755 "${srcdir}/mesa-26-gororoba-asan-run" \
    "${pkgdir}/usr/bin/mesa-26-gororoba-asan-run"

  # Sanity: confirm the instrumented driver objects actually staged (the wrapper
  # is useless without them), but do NOT do any /usr activation.
  if [ ! -e "${pkgdir}${_prefix}/lib/libvulkan_r300.so" ] && \
     [ ! -e "${pkgdir}${_prefix}/lib/libgallium"*.so ] 2>/dev/null; then
    echo "ERROR: no staged driver .so under ${_prefix}/lib; the maximal builddir did not install." >&2
    return 1
  fi

  if [ -f "${_srcroot}/docs/license.rst" ]; then
    install -Dm644 "${_srcroot}/docs/license.rst" \
      "${pkgdir}/usr/share/licenses/${pkgname}/license.rst"
  fi
}
