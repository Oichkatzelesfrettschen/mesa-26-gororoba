#!/bin/sh
# Run a command against the scoped ASAN+UBSAN r300 driver staged in
# /opt/mesa-26-gororoba-asan, WITHOUT making it the system Mesa.  An ASan/UBSan
# .so cannot be the default /usr Mesa (every GL/VK app would abort with "ASan
# runtime does not come first in initial library list"), so this driver is only
# ever reached through this wrapper, which preloads the sanitizer runtime first
# and points the GL + Vulkan loaders at the /opt tree for the wrapped process.
#
# Usage:  mesa-26-gororoba-asan-run vkcube
#         mesa-26-gororoba-asan-run glxgears
#         ASAN_OPTIONS=detect_leaks=1 mesa-26-gororoba-asan-run <app>
set -eu
PREFIX=/opt/mesa-26-gororoba-asan

# The Clang ASan runtime must be the first object loaded (the app binary is not
# sanitizer-built), so LD_PRELOAD it.  Resolve it from clang, fall back to the
# pinned clang-22 path.
ASAN_RT="$(clang -print-file-name=libclang_rt.asan-x86_64.so 2>/dev/null || true)"
[ -e "${ASAN_RT:-}" ] || ASAN_RT=/usr/lib/clang/22/lib/linux/libclang_rt.asan-x86_64.so
if [ ! -e "$ASAN_RT" ]; then
  echo "mesa-26-gororoba-asan-run: ASan runtime not found ($ASAN_RT); install clang." >&2
  exit 1
fi

ICD="$(ls "$PREFIX"/share/vulkan/icd.d/*.json 2>/dev/null | head -1 || true)"

export LD_PRELOAD="${ASAN_RT}${LD_PRELOAD:+:$LD_PRELOAD}"
export LD_LIBRARY_PATH="$PREFIX/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
export LIBGL_DRIVERS_PATH="$PREFIX/lib/dri"
[ -n "$ICD" ] && export VK_ICD_FILENAMES="$ICD"
# Maximal info, do not abort on first finding (collect every report); leak
# detection off by default (Mesa's exit-time pools are noise -- override to 1
# when hunting leaks).  UBSan prints a stack per finding.
export ASAN_OPTIONS="${ASAN_OPTIONS:-detect_leaks=0:halt_on_error=0:abort_on_error=0:print_stats=0}"
export UBSAN_OPTIONS="${UBSAN_OPTIONS:-print_stacktrace=1:halt_on_error=0}"
# Free, built-in Mesa GPU tracing alongside the sanitizers (override to taste).
export RADEON_DEBUG="${RADEON_DEBUG:-info}"

exec "$@"
