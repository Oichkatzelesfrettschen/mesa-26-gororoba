# mesa-gororoba-gpu-debug-stack: the full RS482/r300 GPU debug stack in one
# install.  A depends-only meta-package -- it ships no driver of its own; it pulls
# the scoped ASan+UBSan driver, the gororoba umr fork, and the radeon-KMD
# instrumentation tool set, and installs the stack documentation.  Installing this
# gives you everything needed for sanitizer-backed GPU RCA on RS482 alongside the
# release/debug system drivers.  See /usr/share/doc/mesa-gororoba-gpu-debug-stack/
# for the tier table and the per-tool invocations against the ASan driver.
pkgname=mesa-gororoba-gpu-debug-stack
pkgver=26.2.0
pkgrel=1
epoch=2
pkgdesc='Meta-package: the RS482/r300 GPU debug stack -- scoped ASan+UBSan driver + umr-gororoba + radeon-KMD instrumentation tools (bpftrace/valgrind/gdb/radeontop/perf) + docs'
arch=('any')
url='https://github.com/Oichkatzelesfrettschen/mesa-26-gororoba'
license=('MIT')
# The stack, pinned in lockstep.  The two gororoba components carry the current
# pkgver so a stack bump tracks the drivers; the tools are by-name (their own
# versions).  bpftrace/perf target the radeon KMD, not amdgpu.
depends=(
  "mesa-gororoba-asan=${epoch}:${pkgver}-${pkgrel}"
  umr-gororoba
  bpftrace valgrind gdb strace radeontop perf lm_sensors
)
# Suggested but not required: the system driver tiers + symbolization extras.
optdepends=(
  'mesa-gororoba-debug: the default debug system driver (gdb/RADEON_DEBUG RCA)'
  'mesa-gororoba: the release conformance/silicon-baseline system driver'
  'pwndbg: nicer gdb for driver state inspection'
  'heaptrack: allocation profiling in the draw path'
)
source=('r300-gpu-debug-stack.md')
sha256sums=('SKIP')

package() {
  install -Dm644 "${srcdir}/r300-gpu-debug-stack.md" \
    "${pkgdir}/usr/share/doc/${pkgname}/r300-gpu-debug-stack.md"
}
