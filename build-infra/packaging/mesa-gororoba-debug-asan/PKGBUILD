# mesa-gororoba-debug-asan: the PRIME r300 tier -- the highest-information RCA
# driver.  Maximal compile-time instrumentation (AddressSanitizer +
# UndefinedBehaviorSanitizer + the extended sanitizer set, live asserts, -g3,
# frame pointers, sibling-call folding off) at -O0, repacked from the build-infra
# prime profile 1_r300_full_debug_asan_o0.
#
# LOCKED SAFETY INVARIANT -- this is NEVER the system Mesa.  It installs ONLY to
# /opt/mesa-gororoba-debug-asan plus one /usr/bin wrapper; it does NOT symlink
# into /usr, does NOT provide/conflict/replace mesa, and drops no ld.so.conf path.
# An ASan-instrumented libGL/libvulkan as the system Mesa aborts every GL/VK client
# ("ASan runtime does not come first in initial library list") and can black-screen
# the login session.  package() enforces this mechanically: it fails the build if
# anything staged a /usr loader object or an ld.so.conf.d activation.  Reached only
# through mesa-gororoba-debug-asan-run (LD_PRELOAD the ASan runtime, point the
# loaders at /opt).  The system /usr Mesa is mesa-gororoba-debug-optimized (or the
# reserved mesa-gororoba release) -- never this.
#
# Build model: REPACK.  Build/refresh the prime builddir, then this PKGBUILD
# stages it:
#   make rebuild-1_r300_full_debug_asan_o0_x86_64v1-clang22-distcc-cache
pkgname=mesa-gororoba-debug-asan
pkgver=26.2.0
pkgrel=1
epoch=2
pkgdesc='PRIME r300 debug driver (NEVER system Mesa): ASan+UBSan+extended sanitizers, -O0 -g3, r300 GL + r300vk ICD under /opt, run via mesa-gororoba-debug-asan-run; the highest-information GPU RCA tier alongside the debug-optimized/release system drivers'
arch=('x86_64')
url='https://github.com/Oichkatzelesfrettschen/mesa-26-gororoba'
license=('MIT')
# Runtime libs the instrumented driver links, plus clang for the ASan runtime the
# wrapper LD_PRELOADs (compiler-rt ships in clang) and the loaders it points at.
depends=(
  clang compiler-rt
  expat glibc libdrm libelf libgcc libglvnd libstdc++ libx11 libxcb libxext
  libxdamage libxshmfence libxxf86vm libva lm_sensors spirv-tools
  wayland zlib zstd vulkan-icd-loader libunwind valgrind
)
makedepends=(meson ninja)
# No system-driver metadata: NO provides/conflicts/replaces of mesa (the locked
# invariant).  It only replaces the former mesa-gororoba-asan name so an installed
# one migrates to this rename.  It owns only /opt/mesa-gororoba-debug-asan + the
# wrapper; it never touches /usr, so it co-installs with every system driver.
replaces=('mesa-gororoba-asan')
conflicts=('mesa-gororoba-asan')
provides=("mesa-gororoba-asan=${epoch}:${pkgver}-${pkgrel}")
options=('!strip' '!lto' 'debug' 'staticlibs' '!buildflags')
source=('mesa-gororoba-debug-asan-run')
sha256sums=('SKIP')

_prefix=/opt/mesa-gororoba-debug-asan
_builddir="${GOROROBA_DEBUG_ASAN_BUILDDIR:-/home/eirikr/workspaces/mesa/mesa-26-gororoba/build/mesa-1_r300_full_debug_asan_o0_x86_64v1-clang22-distcc-cache}"
_srcroot="${GOROROBA_DEBUG_ASAN_SRCROOT:-/home/eirikr/workspaces/mesa/mesa-26-gororoba}"

package() {
  if [ ! -f "${_builddir}/build.ninja" ]; then
    echo "ERROR: prime asan+ubsan builddir not found at ${_builddir}" >&2
    echo "       build it: make rebuild-1_r300_full_debug_asan_o0_x86_64v1-clang22-distcc-cache" >&2
    return 1
  fi
  # Stage the prebuilt /opt tree ONLY.  --no-rebuild: never recompile here.  The
  # builddir prefix is /opt/mesa-gororoba-debug-asan (set by the profile
  # install prefix), so meson install lands the whole instrumented driver there.
  meson install -C "${_builddir}" --no-rebuild --destdir "${pkgdir}"

  # The only /usr file: the run-wrapper.  Everything else stays under /opt so the
  # system Mesa is untouched.
  install -Dm755 "${srcdir}/mesa-gororoba-debug-asan-run" \
    "${pkgdir}/usr/bin/mesa-gororoba-debug-asan-run"

  # Sanity: confirm the instrumented driver objects actually staged (the wrapper
  # is useless without them), but do NOT do any /usr activation.
  if [ ! -e "${pkgdir}${_prefix}/lib/libvulkan_r300.so" ] && \
     [ ! -e "${pkgdir}${_prefix}/lib/libgallium"*.so ] 2>/dev/null; then
    echo "ERROR: no staged driver .so under ${_prefix}/lib; the prime builddir did not install." >&2
    return 1
  fi

  # LOCKED INVARIANT (mechanical): the prime tier must NEVER become system Mesa.
  # Fail the build if anything staged a /usr loader object or an ld.so.conf.d
  # activation -- the two things that would make an ASan driver the /usr default
  # and black-screen the login session.
  local _violation=""
  if [ -d "${pkgdir}/usr/lib" ]; then
    _violation="$(find "${pkgdir}/usr/lib" \( -name 'libGL*' -o -name 'libEGL*' \
      -o -name 'libGLX*' -o -name 'libvulkan_*' -o -name 'libgbm*' \
      -o -name 'libxatracker*' -o -path '*/dri/*' \) -print 2>/dev/null)"
  fi
  if [ -e "${pkgdir}/etc/ld.so.conf.d" ]; then
    _violation="${_violation} ${pkgdir}/etc/ld.so.conf.d"
  fi
  if [ -n "${_violation# }" ]; then
    echo "ERROR: prime/asan tier staged /usr loader or ld.so.conf.d activation -- forbidden:" >&2
    printf '  %s\n' ${_violation} >&2
    echo "       the prime ASan driver must stay /opt-scoped + wrapper-only." >&2
    return 1
  fi

  if [ -f "${_srcroot}/docs/license.rst" ]; then
    install -Dm644 "${_srcroot}/docs/license.rst" \
      "${pkgdir}/usr/share/licenses/${pkgname}/license.rst"
  fi
}
