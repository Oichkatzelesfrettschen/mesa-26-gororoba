# Maintainer: mesa-26-gororoba maintainers
# mesa-gororoba: a system Mesa replacement build from the mesa-26-gororoba fork.
# It installs the r300 Gallium GL driver, the zink GL-on-Vulkan Gallium
# driver, the XA/Xv 2D-acceleration state tracker (libxatracker), and the
# amd_r300 (r300vk) Vulkan ICD into the normal Mesa loader paths so RS482
# daily-driver testing uses the fork by default.
#
# Scope is deliberately RS482-focused: r300 hardware GL + the r300vk Vulkan
# ICD + zink riding that ICD for the GL-atop-Vulkan lane + XA/Xv and
# gallium-va MPEG-2 decode on the 3D pipe.  No llvmpipe and no LLVM: the
# vertex stage runs the C draw path so the in-development hybrid TCL is the
# code that executes, and a probe gets hardware r300 or fails loudly instead
# of silently tracing through a software rasterizer.  OpenCL (rusticl) is not
# built.  Build for the x86-64 psABI baseline so the artifact runs on the K8
# Turion 64 X2 in the Vostro (no SSE4.2/AVX).
#
# Two lanes, do not confuse them:
#   * DEV / rapid iteration: build the devenv tree (ninja -C <builddir>) and run
#     via VK_DRIVER_FILES (Vulkan) or LIBGL_DRIVERS_PATH+LD_LIBRARY_PATH (GL).
#     Incremental, seconds per file.  This package is NOT for per-file iteration.
# Build profile: debugoptimized (-O2 -g) with assertions live (b_ndebug=false)
# and valgrind, libunwind, and perfetto/gpuvis tracing enabled.  This is the
# deliberate current default: the installed /usr stack stays debuggable so a
# crash on the daily driver gives symbols, a firing assertion, and valgrind
# locality without a separate build.  It is -O2, so not a performance cliff,
# but assertions can abort a CTS case that a pure release build would pass --
# the canonical 1_r300 measurement profile stays buildtype=release for clean
# conformance baselines; this package is the debuggable daily driver.
#
#   * RELEASE / system install: this PKGBUILD -> /usr, replacing stock mesa.
#     Promote here once a change is stable enough for normal desktop and
#     headless probe use on the target RS482 host.
#
# Install / reinstall:
#   sudo pacman -U mesa-gororoba-*.pkg.tar.zst
# Run probes with the RS482-focused loader overrides:
#   mesa-26-gororoba-run glxinfo -B
#   mesa-26-gororoba-run eglinfo -B -p surfaceless
#   mesa-26-gororoba-run vainfo --display drm --device /dev/dri/renderD128
#   mesa-26-gororoba-run vulkaninfo --summary

pkgname=mesa-gororoba
pkgver=26.2.0
pkgrel=14
epoch=2
# Tracks the latest main HEAD via #branch=main in source below; the source is
# the public fork, not a local path.  To pin a reproducible build instead,
# replace #branch=main with #commit=<sha>.
pkgdesc='Mesa system replacement: r300 GL + zink + XA/Xv + VA MPEG-2 + amd_r300/r300vk Vulkan ICD + overlay/device-select Vulkan layers, no LLVM, debugoptimized+asserts+valgrind/libunwind/perfetto, x86-64 baseline'
arch=('x86_64')
url='https://github.com/Oichkatzelesfrettschen/mesa-26-gororoba'
license=('MIT')

depends=(
  expat glibc libdrm libelf libgcc libglvnd libstdc++ libx11 libxcb libxext
  libxdamage libxshmfence libxxf86vm libva lm_sensors spirv-tools
  wayland zlib zstd vulkan-icd-loader
)
makedepends=(
  clang llvm meson ninja glslang python-mako python-ply wayland-protocols
  libxrandr xorgproto libxml2 lld git
)
# vulkan-mesa-implicit-layers: this release build ships the mesa overlay +
# device-select layers (vulkan-layers below), so it owns and provides the
# implicit-layer slot exactly like the debug sibling.  device-select is the
# implicit layer that vulkan-mesa-implicit-layers ships and that
# lib32-vulkan-mesa-implicit-layers depends on by name; provide it specifically
# (not the broader vulkan-mesa-layers / vulkan-mesa-device-select virtuals) so a
# pacman -U takes the implicit-layer slot over cleanly while the by-name lib32
# dependent stays satisfied.  The explicit overlay layer has no by-name dependent;
# its files are simply owned without a provide.
provides=(
  "mesa=${epoch}:${pkgver}-${pkgrel}"
  "libva-mesa-driver=${epoch}:${pkgver}-${pkgrel}"
  "mesa-libgl=${epoch}:${pkgver}-${pkgrel}"
  "vulkan-mesa-implicit-layers=${epoch}:${pkgver}-${pkgrel}"
  libva-driver
  opengl-driver
  vulkan-driver
)
conflicts=(mesa vulkan-mesa-implicit-layers vulkan-radeon lib32-vulkan-radeon 'libva-mesa-driver<1:24.2.7-1' 'mesa-libgl<17.0.1-2')
replaces=(mesa vulkan-mesa-implicit-layers vulkan-radeon lib32-vulkan-radeon 'libva-mesa-driver<1:24.2.7-1' 'mesa-libgl<17.0.1-2')
options=('!lto' '!strip')
install="${pkgname}.install"
source=("${pkgname}::git+https://github.com/Oichkatzelesfrettschen/mesa-26-gororoba.git#branch=main"
        'mesa-26-gororoba-env.sh'
        'mesa-26-gororoba-run'
        'mesa-26-gororoba-profile.sh'
        '90-mesa-gororoba-r300.conf'
        '20-rs482-modesetting-glamor.conf')
sha256sums=('SKIP'
            '0c12e545fce6324fcca354a33934f042a15b05bb40993e1637becfdf494d80ec'
            '1aba100cad006b67b31be2c5c31814e25a58d74c320d556678136bef726138c9'
            '091cafc777b91f59d6fcabf2c2229655d6c79c439fc3a2f77a960ba68190b849'
            'ccc7ad98af4aa71573d9131bfee76714f7c43eb41f4af05b0ddd776cae2a98df'
            'db99ee65f746c9f122477d2cb4e47a184a0153012c992b74e1f1cf0e65187ebd')

_prefix=/usr

build() {
  # Build through the Vostro distcc+ccache fabric when the checked-out source
  # carries that host env; the emitted code stays x86-64 generic through the
  # flags below.
  if [ -f "${pkgname}/build-infra/env/vostro1000-x86-64-v1-clang22-ccache-distcc.env" ]; then
    # shellcheck disable=SC1091
    . "${pkgname}/build-infra/env/vostro1000-x86-64-v1-clang22-ccache-distcc.env" || true
  fi
  if command -v ccache >/dev/null 2>&1; then
    export CC='ccache clang'
    export CXX='ccache clang++'
  else
    export CC=clang
    export CXX=clang++
  fi
  export CC_LD=lld
  export CXX_LD=lld

  # x86-64 psABI baseline so the artifact runs on the K8 Turion (no SSE4.2/AVX).
  # Exported here so they override any host-native -march the build host's
  # makepkg.conf injects; meson folds CFLAGS/CXXFLAGS/LDFLAGS into its arg base.
  # Keep the default machine-neutral: no -pipe, no LTO, no -fno-plt, no
  # native tune.  target-cpu=x86-64 guards any Rust translation unit from
  # emitting K8-incompatible code.
  export CPPFLAGS='-D_FORTIFY_SOURCE=2'
  export CFLAGS='-march=x86-64 -mtune=generic -O2 -g -fexceptions -fstack-protector-strong -fstack-clash-protection -fcf-protection -Wformat -Werror=format-security'
  export CXXFLAGS="${CFLAGS} -Wp,-D_GLIBCXX_ASSERTIONS"
  export LDFLAGS='-Wl,-O1 -Wl,--sort-common -Wl,--as-needed -Wl,-z,relro'
  export RUSTFLAGS='-C target-cpu=x86-64'

  # Idempotent across repeated build() invocations (e.g. makepkg -e): a stale
  # build/ from a prior run would make meson setup abort with "already
  # configured".
  rm -rf build
  meson setup build "${pkgname}" \
    --prefix="${_prefix}" \
    --sysconfdir=/etc \
    --buildtype=debugoptimized \
    --wrap-mode=default \
    -D optimization=2 \
    -D b_ndebug=false \
    -D b_lto=false \
    -D platforms=x11,wayland \
    -D gallium-drivers=r300,zink \
    -D vulkan-drivers=amd_r300 \
    -D vulkan-layers=overlay,device-select \
    -D r300vk-gallium-backend=true \
    -D gallium-rusticl=false \
    -D llvm=disabled \
    -D draw-use-llvm=false \
    -D egl=enabled \
    -D gbm=enabled \
    -D glx=dri \
    -D gles1=enabled \
    -D gles2=enabled \
    -D opengl=true \
    -D glvnd=enabled \
    -D gallium-va=enabled \
    -D video-codecs=mpeg12dec \
    -D gallium-xa=true \
    -D valgrind=enabled \
    -D libunwind=enabled \
    -D perfetto=true \
    -D gpuvis=true \
    -D allow-fallback-for=perfetto

  # Fan out across the distcc workers: meson compile defaults ninja to
  # local-cores+2 (4 on the K8), which starves the remote slots.
  # GOROROBA_DISTCC_JOBS is the slot-sum exported by the host env.
  meson compile -C build -j "${GOROROBA_DISTCC_JOBS:-$(nproc)}"
}

package() {
  meson install -C build --no-rebuild --destdir "${pkgdir}"

  install -Dm755 mesa-26-gororoba-run \
    "${pkgdir}/usr/bin/mesa-26-gororoba-run"
  install -Dm644 mesa-26-gororoba-env.sh \
    "${pkgdir}/etc/opt/mesa-26-gororoba/mesa-26-gororoba-env.sh"
  install -Dm644 mesa-26-gororoba-profile.sh \
    "${pkgdir}/etc/profile.d/mesa-26-gororoba.sh"
  install -Dm644 90-mesa-gororoba-r300.conf \
    "${pkgdir}/usr/lib/environment.d/90-mesa-gororoba-r300.conf"
  install -Dm644 20-rs482-modesetting-glamor.conf \
    "${pkgdir}/usr/share/mesa-26-gororoba/xorg/20-rs482-modesetting-glamor.conf"

  # Compatibility aliases for older build-infra and local scripts.  Release
  # artifacts live in the system Mesa prefix; debug artifacts keep their own
  # opt prefix.  /usr/share/mesa-26-gororoba is NOT aliased to /usr: it is a real
  # directory holding the staged xorg.conf.d sample installed above; a symlink
  # there would land the sample at /usr/xorg through the link and drop the
  # directory.
  install -dm755 "${pkgdir}/opt/local" "${pkgdir}/opt/share"
  ln -s /usr \
    "${pkgdir}/opt/local/mesa-26-gororoba"
  ln -s /usr \
    "${pkgdir}/opt/share/mesa-26-gororoba"

  # Own the runtime linker-path drop-in (same file the debug variant owns) and
  # point it at this /usr drop-in's lib dir.  /usr/lib is already a standard
  # ldconfig path so the entry is a no-op for the release, but owning the file
  # means a swap from the debug variant rewrites the path away from the debug
  # /opt tree (whose lib dir the swap deletes) instead of orphaning it -- which
  # is what black-screened the console on reboot.  The .install re-runs ldconfig.
  install -dm755 "${pkgdir}/etc/ld.so.conf.d"
  printf '%s\n' '/usr/lib' \
    > "${pkgdir}/etc/ld.so.conf.d/00-mesa-26-gororoba-deps.conf"

  # Boot-safety guard.  The release variant installs the gbm/glvnd runtime as
  # real /usr/lib files, but nothing fails the build if a meson option ever
  # drops gbm -- the package would still install and black-screen the console on
  # the next reboot (X modesetting dlopens libgbm.so.1 by SONAME; glvnd resolves
  # libGLX_mesa.so.0 / libEGL_mesa.so.0).  Refuse to ship a system Mesa missing
  # any of them.
  local _need _missing=""
  for _need in libgbm.so.1 libGLX_mesa.so.0 libEGL_mesa.so.0; do
    [ -e "${pkgdir}/usr/lib/${_need}" ] || _missing="${_missing} /usr/lib/${_need}"
  done
  if [ -n "${_missing}" ]; then
    echo "ERROR: boot-critical loader objects missing from the staged package:${_missing}" >&2
    echo "       the gbm/glvnd runtime did not build or stage; refusing to ship a system" >&2
    echo "       Mesa that black-screens X (modesetting dlopen libgbm.so.1) on reboot." >&2
    return 1
  fi

  # Mesa ships its license summary as docs/license.rst (Arch/CachyOS practice).
  # A missing license is a packaging defect, not something to swallow silently.
  if [ -f "${pkgname}/docs/license.rst" ]; then
    install -Dm644 "${pkgname}/docs/license.rst" \
      "${pkgdir}/usr/share/licenses/${pkgname}/license.rst"
  else
    echo "WARNING: ${pkgname}/docs/license.rst not found; license not installed"
  fi
}
