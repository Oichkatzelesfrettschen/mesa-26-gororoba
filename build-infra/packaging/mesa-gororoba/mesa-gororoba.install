# Stock-path Mesa deployment uses package ownership and the standard linker cache.
post_install() {
  ldconfig
  cat <<'EOF'
Mesa owns its selected release or debug payload under /usr.
The r300/zink Gallium drivers and R3V library share the stock GLX/EGL/GBM paths.
The R3V manifest is selected explicitly with mesa-gororoba-run.
Sanitizer experiments use build-owned staging through build-infra.
Restart the display stack after replacing its loaded Mesa libraries.
EOF
}
post_upgrade() { post_install; }
post_remove() { ldconfig; }
