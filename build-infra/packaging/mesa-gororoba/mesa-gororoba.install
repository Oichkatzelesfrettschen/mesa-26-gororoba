# mesa-gororoba install scriptlet: surface the non-obvious consequences of a
# side-by-side Mesa fork build.

_notes() {
  cat <<'EOF'
mesa-gororoba installed an RS482-scoped fork build under /opt/mesa-26-gororoba:
  * GL: r300 hardware + llvmpipe software fallback (egl/glx/gles/gbm/glvnd).
  * Vulkan: amd_r300 (r300vk) ICD under /opt/mesa-26-gororoba/share/vulkan/icd.d.
  * Wrapper: mesa-26-gororoba-run scopes loader variables to one command.
Consequences to know:
  * llvm coupling: llvmpipe links libLLVM.so of the build host's llvm major.
    If the installed llvm-libs major differs, llvmpipe paths fail to dlopen --
    rebuild mesa-gororoba against the current llvm.
  * stock mesa remains the system default.  Compare explicitly, for example:
      mesa-26-gororoba-run glxinfo -B
      mesa-26-gororoba-run eglinfo
      mesa-26-gororoba-run vainfo
      mesa-26-gororoba-run vulkaninfo --summary
  * compatibility aliases are package-managed:
      /opt/local/mesa-26-gororoba -> /opt/mesa-26-gororoba
      /opt/share/mesa-26-gororoba -> /opt/mesa-26-gororoba
      /usr/share/mesa-26-gororoba -> /opt/mesa-26-gororoba
EOF
}

post_install() {
  _notes
}

post_upgrade() {
  _notes
}
