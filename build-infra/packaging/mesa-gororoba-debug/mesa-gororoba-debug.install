_debug_prefix=/opt/mesa-26-gororoba-debug

post_install() {
  cat <<MSG
mesa-gororoba-debug installed to ${_debug_prefix} (parallel to stock mesa and the release /opt build).
Point a probe at it explicitly:
  mesa-26-gororoba-debug-run glxinfo -B
  mesa-26-gororoba-debug-run eglinfo
  mesa-26-gororoba-debug-run vainfo
  mesa-26-gororoba-debug-run vulkaninfo --summary
  mesa-26-gororoba-debug-run gdb --args <consumer>
Compatibility aliases are package-managed:
  /opt/local/mesa-26-gororoba-debug -> ${_debug_prefix}
  /opt/share/mesa-26-gororoba-debug -> ${_debug_prefix}
It carries no provides/conflicts/replaces; stock mesa remains the system default.
MSG
}

post_upgrade() {
  post_install
}
