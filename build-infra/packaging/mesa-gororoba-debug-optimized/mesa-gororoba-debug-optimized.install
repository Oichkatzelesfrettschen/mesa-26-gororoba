_debug_prefix=/opt/mesa-gororoba-debug-optimized
_ld_conf=/etc/ld.so.conf.d/00-mesa-gororoba-deps.conf

pre_install() {
  # A pre-packaging install left this conf unowned (and possibly pointing at a
  # now-dead variant path).  Remove it so this package can own the file without
  # a filesystem conflict; package() reinstalls it pointing at the live lib dir.
  if [ -e "${_ld_conf}" ] && ! pacman -Qqo "${_ld_conf}" >/dev/null 2>&1; then
    rm -f "${_ld_conf}"
  fi
}

post_install() {
  # Index the variant's bundled libs onto the runtime linker path so the
  # 64-bit libgbm.so.1 (and the rest of the /opt tree) resolve before the next
  # reboot drives X -- otherwise modesetting cannot dlopen libgbm and the
  # console black-screens.
  ldconfig
  cat <<MSG
mesa-gororoba-debug is now the active system Mesa (mesa-git packaging model).
Its real files live under ${_debug_prefix} (debugoptimized, kept out of /usr);
the stock /usr loader paths are package-managed symlinks into that tree:
  /usr/lib/libGL* /usr/lib/libEGL* /usr/lib/libgallium-*.so /usr/lib/libvulkan_r3v.so
  /usr/lib/dri/*  /usr/share/vulkan/icd.d/ (Gallium and release ICDs)  /usr/share/glvnd/egl_vendor.d/*
  The native r3v ICD manifests remain under ${_debug_prefix}/share/vulkan/icd.d
  and are selected only by the scoped native launcher.
Compatibility aliases (probes and build-infra scripts):
  /opt/local/mesa-gororoba-debug-optimized -> ${_debug_prefix}
  /opt/share/mesa-gororoba-debug-optimized -> ${_debug_prefix}
  /usr/share/mesa-gororoba-debug-optimized -> ${_debug_prefix}
This is an assertions-live debug build: a Mesa assert can abort a GL/Vulkan
client that the release would pass.  For conformance runs use the release
mesa-gororoba.  Revert the system driver with:
  pacman -U mesa-gororoba        # back to the release /usr build
For a one-command scoped probe without changing the default, use:
  mesa-gororoba-debug-optimized-run vulkaninfo --summary
For the native r3v ICD retained under /opt, use:
  mesa-gororoba-debug-optimized-native-run vulkaninfo --summary
MSG
}

pre_upgrade() {
  pre_install
}

post_upgrade() {
  post_install
}

post_remove() {
  # The owned conf went away with the package; re-index so the linker path no
  # longer references this variant's now-removed /opt lib dir.  The replacement
  # system Mesa's own post_install will re-point and re-index for its variant.
  ldconfig
  cat <<MSG
mesa-gororoba-debug removed.  Reinstall a system Mesa so GL/Vulkan clients keep
working: pacman -U mesa-gororoba  (release build) or pacman -S mesa (stock).
MSG
}
