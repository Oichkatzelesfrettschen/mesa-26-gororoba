# mesa-gororoba-debug-optimized: the PRIMARY/default r300 Mesa installation for
# the Vostro 1000 (RS482, AMD Turion 64 X2).  This is the canonical daily-driver
# install target: debugoptimized -O2 -g3, assertions live, full debug info, frame
# pointers, and the complete r300 feature surface (desktop GL 2.1 + GLES1/2,
# GLVND, EGL/GBM, GLX-DRI, gallium-va MPEG-2 decode, gallium-xa XA tracker /
# libxatracker.so, ati_r300/r3v Vulkan ICD, anti-lag + device-select implicit
# Vulkan layers, an /opt-scoped overlay, nir/glsl offline compiler tools,
# valgrind annotations, libunwind
# backtraces, perfetto CPU timeline, no LLVM).
#
# Tier map (all build the same full r300 surface; this package is the default):
#   * mesa-gororoba (profile 1_)  -- TRUE RELEASE, no asserts, /usr, RESERVED.
#   * THIS (profile 2_)           -- debugoptimized, asserts, /usr, the DEFAULT.
#   * mesa-gororoba-debug-o0 (3_) -- -O0 normal debug, /opt + run-wrapper.
#   * mesa-gororoba-asan (7_)     -- ASan+UBSan, /opt + run-wrapper.
# Only one package owns the /usr Mesa paths at a time; the -o0 and asan tiers are
# /opt-scoped and co-install, reached through their run-wrappers.
#
# Renamed from mesa-gororoba-debug: the package label is now -debug-optimized to
# distinguish it from the new -o0 normal-debug tier.  The /opt prefix and the
# run-wrapper keep the mesa-gororoba-debug-optimized name (the 2_ builddir's install
# prefix), so the rename is a pure repack -- no recompile.  provides/replaces the
# old mesa-gororoba-debug name so pacman migrates an installed one in place.
#
# Build model: REPACK, not from-git.  The build-infra meson builddir is the only
# build infrastructure -- build/refresh it with
#   make rebuild-3_r300_full_debug_optimized_x86_64v1-clang22-distcc-cache
# (or `make build ... PREFIX=/opt/mesa-gororoba-debug-optimized`), then this PKGBUILD
# packages that exact builddir.  It deliberately does NOT clone+build from a
# pinned git commit: the in-development r3v compute kernels live only in the
# working tree the builddir was compiled from, so a hermetic git build would
# ship a different binary than the one under test.  _builddir/_srcroot select the
# canonical Vostro builddir + source root and are overridable from the make env.
#
# Packaging model (mesa-git): when installed, this debug build BECOMES the active
# system Mesa, exactly like the release mesa-gororoba and upstream mesa-git.  It
# differs only in where the real files live: because it is debugoptimized (-O2
# -g3, assertions, frame pointers), the artifacts stay in /opt/mesa-gororoba-debug-optimized
# instead of the stock /usr tree, and the stock /usr loader paths (libGL/EGL/GLX/
# GBM, lib/dri, libxatracker, the Vulkan ICD + layers, the glvnd EGL vendor json)
# are symlinked into that /opt tree by package().  provides/conflicts/replaces
# therefore mirror the release package and also supersede it, so exactly one
# mesa-gororoba owns the /usr paths at a time.  Revert with
# `pacman -U mesa-gororoba` (release) or `pacman -S mesa` (stock).
# mesa-gororoba-debug-optimized-run still pins the loader to the /opt tree for a scoped
# probe without changing the system default.
pkgname=mesa-gororoba-debug-optimized
for _legacy_name in GOROROBA_DEBUG_BUILDDIR GOROROBA_DEBUG_SRCROOT; do
  if [[ -v $_legacy_name ]]; then
    echo "${_legacy_name} was renamed by replacing GOROROBA_ with MESA_" >&2
    exit 2
  fi
done
unset _legacy_name
pkgver=26.2.0
pkgrel=22
epoch=2
pkgdesc='Mesa r300 system driver (PRIMARY/default install): debugoptimized -O2 -g3, assertions live, frame pointers; r300 GL + zink GL-on-Vulkan, GLES+EGL+GBM, gallium-xa XA tracker, gallium-va MPEG-2, ati_r300/r3v ICD + anti-lag/device-select implicit Vulkan layers, files under /opt'
arch=('x86_64')
url='https://github.com/Oichkatzelesfrettschen/mesa-26-gororoba'
license=('MIT')
depends=(
  expat glibc libdrm libelf libgcc libglvnd libstdc++ libx11 libxcb libxext
  libxdamage libxshmfence libxxf86vm libva lm_sensors spirv-tools
  wayland zlib zstd vulkan-icd-loader libunwind valgrind
)
# No toolchain makedepends: the build-infra builddir is already compiled; this
# package only stages and symlinks it with meson install --no-rebuild.  python
# runs the promotion gate in check().
makedepends=(meson ninja python)
# System-driver metadata, mirroring the release mesa-gororoba package and
# additionally superseding it: installing the debug package takes over the
# system /usr Mesa from stock mesa OR the release build.  conflicts blocks
# co-installation (the /usr symlinks would clash with stock mesa's real files);
# replaces makes `pacman -U` migrate cleanly off whichever Mesa is present.
#
# The profile builds Arch's complete implicit-layer pair, anti-lag plus
# device-select, and also builds overlay for /opt-scoped debugging.  Only the
# implicit pair is activated under /usr.  The legacy vulkan-mesa-device-select
# provide preserves old lib32 dependencies during the package rename; the
# explicit vulkan-mesa-layers package keeps sole ownership of /usr overlay files.
provides=(
  "mesa=${epoch}:${pkgver}-${pkgrel}"
  "mesa-gororoba-debug=${epoch}:${pkgver}-${pkgrel}"
  "libva-mesa-driver=${epoch}:${pkgver}-${pkgrel}"
  "mesa-libgl=${epoch}:${pkgver}-${pkgrel}"
  "vulkan-mesa-implicit-layers=${epoch}:${pkgver}-${pkgrel}"
  "vulkan-mesa-device-select=${epoch}:${pkgver}-${pkgrel}"
  libva-driver
  opengl-driver
  vulkan-driver
  "vulkan-radeon=${epoch}:${pkgver}-${pkgrel}"
)
# This package stages only x86_64 artifacts. A matching lib32 package is
# required before claiming ownership of lib32-vulkan-radeon.
conflicts=(mesa mesa-gororoba mesa-gororoba-debug vulkan-mesa-implicit-layers vulkan-mesa-device-select vulkan-radeon 'libva-mesa-driver<1:24.2.7-1' 'mesa-libgl<17.0.1-2')
replaces=(mesa mesa-gororoba mesa-gororoba-debug vulkan-mesa-implicit-layers vulkan-mesa-device-select vulkan-radeon 'libva-mesa-driver<1:24.2.7-1' 'mesa-libgl<17.0.1-2')
# Keep debug symbols; no strip, no LTO.  !buildflags: this package compiles
# nothing (repack only), so makepkg's CFLAGS/LDFLAGS injection is irrelevant.
# The .a archives the builddir produced land in /opt for gdb work but are NOT
# mirrored into /usr (the system driver needs only the runtime .so and json).
options=('!strip' '!lto' 'debug' 'staticlibs' '!buildflags')
install="${pkgname}.install"
# Only the loader-helper scripts are package sources; the binaries come from the
# prebuilt build-infra builddir (see _builddir), not from a git checkout.
source=('mesa-gororoba-debug-optimized-env.sh'
        'mesa-gororoba-debug-optimized-run')
sha256sums=('94a0330044da95d10074fc6afbc2947fe7fcd59ae1643e4226e7729a46a1091d'
            '244f0c7e2171b5b784b37a08e893c1dbcffdccc1394e0e8f2756d07d7ac330e7')

_prefix=/opt/mesa-gororoba-debug-optimized
# The canonical build-infra builddir to repack, and the source root for the
# license file and the promotion gate.  The recipe sits three levels below the
# source root it belongs to, so the default resolves from the recipe's own
# location and the tree carries no packager's home directory.  Override from
# the make/env (MESA_DEBUG_BUILDDIR / MESA_DEBUG_SRCROOT) when
# packaging from a copied recipe or against another checkout.
_profile=3_r300_full_debug_optimized_x86_64v1-clang22-distcc-cache
_recipe_srcroot="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../.." && pwd)"
_srcroot="${MESA_DEBUG_SRCROOT:-${_recipe_srcroot}}"
_builddir="${MESA_DEBUG_BUILDDIR:-${_srcroot}/build/mesa-${_profile}}"

# Link every entry of ${_prefix}/<rel> into ${pkgdir}/usr/<rel> as a symlink
# back to the absolute /opt path, so the stock GL/EGL/GLX/GBM/Vulkan/VA loaders
# resolve the debug build with no environment override.  Only files and symlinks
# are linked (real subdirectories are handled by their own explicit pass, so a
# directory is never turned into a symlink and never collides with a dir another
# package owns, e.g. /usr/share/vulkan/icd.d).  Static archives are skipped --
# the system driver needs only the runtime objects and loader json.
_link_into_usr() {
  local rel="$1" src dst entry base
  src="${pkgdir}${_prefix}/${rel}"
  [ -d "${src}" ] || return 0
  dst="${pkgdir}/usr/${rel}"
  install -dm755 "${dst}"
  for entry in "${src}"/*; do
    [ -e "${entry}" ] || [ -L "${entry}" ] || continue
    if [ -d "${entry}" ] && [ ! -L "${entry}" ]; then
      continue
    fi
    base="$(basename "${entry}")"
    # vulkan-mesa-layers owns the explicit overlay under /usr.
    case "${rel}/${base}" in
      lib/libVkLayer_MESA_overlay.so) continue ;;
      # The r3v ICD stays an /opt development artifact behind its own
      # launcher until its package-default promotion gate: the system loader
      # follows every manifest in /usr/share/vulkan/icd.d.
      share/vulkan/icd.d/r3v_icd*.json) continue ;;
    esac
    case "${base}" in
      *.a) continue ;;
    esac
    ln -sfn "${_prefix}/${rel}/${base}" "${dst}/${base}"
  done
}

# The promotion gate: this package stages the r3v ICD under its /opt prefix,
# so the surface it ships carries an evidence row for every capability it
# advertises.  The advertised-surface audit reads the native extension table
# and the feature-set guard out of the source root being repacked, and the
# qualification inventory reads the builddir's registered test set, so a
# capability added without its route or a required test dropped from a suite
# refuses the package rather than shipping.  The two programs are the same ones
# the r3v suite registers; running them here puts the gate at the package
# boundary, where the artifact leaves the tree.
check() {
  local vulkan_dir="${_srcroot}/src/amd/r300/vulkan"
  local audit="${vulkan_dir}/tests/r3v_native_advertised_surface_audit.py"
  local inventory="${vulkan_dir}/tests/r3v_qualification_inventory.py"

  if [ ! -f "${audit}" ] || [ ! -f "${inventory}" ]; then
    echo "ERROR: promotion gate programs not found under ${vulkan_dir}" >&2
    echo "       set MESA_DEBUG_SRCROOT to the Mesa source root" >&2
    return 1
  fi
  if [ ! -f "${_builddir}/build.ninja" ]; then
    echo "ERROR: build-infra builddir not found at ${_builddir}" >&2
    return 1
  fi

  # Each instrument proves itself on its own known-good and known-bad
  # inputs before it judges the tree, and every refusal is fatal here
  # rather than by the caller's shell options.
  python3 "${audit}" --selftest || return 1
  python3 "${audit}" --source "${vulkan_dir}/r3v_physical_device.c" \
    || return 1
  python3 "${inventory}" --selftest || return 1
  python3 "${inventory}" "${_builddir}" --require-tests || return 1
}

package() {
  if [ ! -f "${_builddir}/build.ninja" ]; then
    echo "ERROR: build-infra builddir not found at ${_builddir}" >&2
    echo "       build it first: make rebuild-3_r300_full_debug_optimized_x86_64v1-clang22-distcc-cache" >&2
    return 1
  fi

  # Stage the prebuilt /opt tree.  --no-rebuild: never recompile here; the
  # build-infra builddir is authoritative and already carries the in-dev kernels.
  # The builddir is shared with the devenv flow (Makefile PREFIX defaults to
  # /opt/local/<namespace>-<profile>), and meson bakes prefix-derived paths into
  # the driver objects at configure time -- util/xmlconfig.c reads
  # SYSCONFDIR/drirc and DATADIR/drirc.d from those bakes.  Repacking a
  # devenv-configured builddir ships dangling baked paths and silently disables
  # driconf, so refuse any builddir whose configured prefix or sysconfdir
  # disagrees with this package.
  python3 - "${_builddir}" "${_prefix}" <<'PYGATE'
import json
import sys
from pathlib import Path

builddir = Path(sys.argv[1])
expected_prefix = sys.argv[2]
metadata = builddir / "meson-info" / "intro-buildoptions.json"

def reconfigure(detail):
    sys.exit("builddir configure metadata %s: %s -- reconfigure via the"
             " build-infra Makefile (make configure PROFILE=... PREFIX=%s;"
             " it passes --sysconfdir=/etc) before packaging"
             % (detail, metadata, expected_prefix))

try:
    with metadata.open(encoding="utf-8") as source:
        options = json.load(source)
except (OSError, json.JSONDecodeError) as error:
    reconfigure("is unreadable or malformed (%s)" % error)

if not isinstance(options, list):
    reconfigure("has an invalid top-level shape (expected a list)")

opts = {}
for index, option in enumerate(options):
    if not isinstance(option, dict):
        reconfigure("has a non-object option at index %d" % index)
    name = option.get("name")
    if not isinstance(name, str) or "value" not in option:
        reconfigure("has an option without string name and value at index %d" % index)
    opts[name] = option["value"]

if "prefix" not in opts or "sysconfdir" not in opts:
    reconfigure("lacks required prefix or sysconfdir options")

configured_layers = opts.get("vulkan-layers")
if (not isinstance(configured_layers, list) or
        not all(isinstance(layer, str) for layer in configured_layers)):
    reconfigure("has an invalid vulkan-layers option (expected a string list)")

required_layers = {"anti-lag", "device-select"}
missing_layers = sorted(required_layers.difference(configured_layers))
if missing_layers:
    reconfigure("vulkan-layers omits required implicit layers: %s" %
                ", ".join(missing_layers))

bad = []
if opts.get("prefix") != expected_prefix:
    bad.append("prefix=%r (need %r)" % (opts.get("prefix"), expected_prefix))
if opts.get("sysconfdir") != "/etc":
    bad.append("sysconfdir=%r (need '/etc')" % (opts.get("sysconfdir"),))
if bad:
    sys.exit("builddir configure mismatch: %s -- reconfigure via the"
             " build-infra Makefile (make configure PROFILE=... PREFIX=%s;"
             " it passes --sysconfdir=/etc) before packaging"
             % ("; ".join(bad), expected_prefix))
PYGATE

  meson install -C "${_builddir}" --no-rebuild --destdir "${pkgdir}"

  # The package replaces Arch's complete implicit-layer slot.  Verify the
  # staged runtime pair before creating any /usr activation links so stale or
  # incomplete builddirs cannot satisfy the package dependency while dropping
  # an implicit layer.
  local layer_name layer_artifact missing_layer_artifacts=""
  for layer_name in anti_lag device_select; do
    for layer_artifact in \
      "lib/libVkLayer_MESA_${layer_name}.so" \
      "share/vulkan/implicit_layer.d/VkLayer_MESA_${layer_name}.json"; do
      [ -f "${pkgdir}${_prefix}/${layer_artifact}" ] \
        || missing_layer_artifacts="${missing_layer_artifacts} ${_prefix}/${layer_artifact}"
    done
  done
  if [ -n "${missing_layer_artifacts}" ]; then
    echo "ERROR: required Vulkan implicit-layer artifacts are missing:${missing_layer_artifacts}" >&2
    echo "       reconfigure and rebuild profile ${_profile}; refusing to replace" >&2
    echo "       vulkan-mesa-implicit-layers with an incomplete staged tree." >&2
    return 1
  fi

  install -Dm755 "${srcdir}/mesa-gororoba-debug-optimized-run" \
    "${pkgdir}/usr/bin/mesa-gororoba-debug-optimized-run"
  install -Dm644 "${srcdir}/mesa-gororoba-debug-optimized-env.sh" \
    "${pkgdir}/etc/opt/mesa-gororoba-debug-optimized/mesa-gororoba-debug-optimized-env.sh"

  # System-driver activation: mirror the loadable artifacts from the /opt tree
  # into the stock /usr loader paths as symlinks.  These links are what make the
  # debug build the system Mesa and what conflicts with stock mesa's real files.
  _link_into_usr lib                          # libGL/EGL/GLX/GBM/gallium/libvulkan_r3v/libxatracker

  # Indirect GLX vendor link (mesa-git package() convention): glvnd resolves
  # libGLX_indirect.so.0 for indirect rendering to the mesa GLX vendor.  The
  # libGLX_mesa.so.0 it targets is itself a /usr symlink into the /opt tree from
  # the lib pass above; point the indirect link straight at the /opt object so
  # it resolves regardless of link-walk order.
  if [ -e "${pkgdir}${_prefix}/lib/libGLX_mesa.so.0" ]; then
    ln -sfn "${_prefix}/lib/libGLX_mesa.so.0" \
      "${pkgdir}/usr/lib/libGLX_indirect.so.0"
  fi
  _link_into_usr lib/dri                       # r300_dri.so, zink_dri.so, r300_drv_video.so (VA)
  _link_into_usr lib/gbm                       # gbm backends, if built
  # pkg-config surface: the glvnd build emits only gbm.pc and dri.pc (the
  # egl/gl family belongs to libglvnd), and both slots are mesa-owned files
  # this package already conflicts/replaces.  The .pc contents carry the
  # /opt prefix, so linking them is the whole developer-surface fix --
  # pkg-config --cflags gbm resolves the /opt include with no header
  # symlinks (the GL/EGL include directories stay libglvnd's).
  _link_into_usr lib/pkgconfig                 # gbm.pc, dri.pc
  _link_into_usr share/vulkan/icd.d            # r300 Vulkan ICD manifest
  _link_into_usr share/vulkan/implicit_layer.d # anti-lag + device-select
  _link_into_usr share/glvnd/egl_vendor.d      # glvnd EGL vendor selection
  _link_into_usr share/drirc.d                 # driver config quirks

  # Compatibility aliases (probes and build-infra scripts target /opt/local).
  install -dm755 "${pkgdir}/opt/local" "${pkgdir}/opt/share" "${pkgdir}/usr/share"
  ln -s /opt/mesa-gororoba-debug-optimized \
    "${pkgdir}/opt/local/mesa-gororoba-debug-optimized"
  ln -s /opt/mesa-gororoba-debug-optimized \
    "${pkgdir}/opt/share/mesa-gororoba-debug-optimized"
  ln -s /opt/mesa-gororoba-debug-optimized \
    "${pkgdir}/usr/share/mesa-gororoba-debug-optimized"

  # Own the runtime linker-path drop-in and point it at THIS variant's live lib
  # dir.  The debug /opt tree carries its own bundled dependency libs; without
  # this on the linker path, ldconfig cannot resolve the 64-bit libgbm.so.1 the
  # X modesetting driver dlopens, and the console black-screens on reboot.
  # Packaging it (vs an unowned, variant-specific conf) means a debug<->release
  # swap rewrites the path to the installed variant and the .install scriptlet
  # re-runs ldconfig, so reboots stay safe regardless of which variant is in.
  install -dm755 "${pkgdir}/etc/ld.so.conf.d"
  printf '%s\n' '/opt/mesa-gororoba-debug-optimized/lib' \
    > "${pkgdir}/etc/ld.so.conf.d/00-mesa-gororoba-deps.conf"

  # Boot-safety guard. The ld.so.conf drop-in and /usr activation require the
  # GBM/glvnd runtime plus GBM's dri_gbm.so fallback backend. Verify the staged
  # /opt tree and the activated /usr paths before packaging a system Mesa.
  local _need _missing=""
  for _need in libgbm.so.1 libGLX_mesa.so.0 libEGL_mesa.so.0; do
    [ -e "${pkgdir}${_prefix}/lib/${_need}" ] \
      || _missing="${_missing} ${_prefix}/lib/${_need}"
  done
  [ -e "${pkgdir}${_prefix}/lib/gbm/dri_gbm.so" ] \
    || _missing="${_missing} ${_prefix}/lib/gbm/dri_gbm.so"
  [ -e "${pkgdir}/usr/lib/libgbm.so.1" ] || [ -L "${pkgdir}/usr/lib/libgbm.so.1" ] \
    || _missing="${_missing} /usr/lib/libgbm.so.1(activation)"
  [ -e "${pkgdir}/usr/lib/gbm/dri_gbm.so" ] || [ -L "${pkgdir}/usr/lib/gbm/dri_gbm.so" ] \
    || _missing="${_missing} /usr/lib/gbm/dri_gbm.so(activation)"
  if [ -n "${_missing}" ]; then
    echo "ERROR: boot-critical loader objects missing from the staged package:${_missing}" >&2
    echo "       the gbm/glvnd runtime did not build or stage; refusing to ship a system" >&2
    echo "       Mesa that black-screens X (modesetting dlopen libgbm.so.1) on reboot." >&2
    return 1
  fi

  if [ -f "${_srcroot}/docs/license.rst" ]; then
    install -Dm644 "${_srcroot}/docs/license.rst" \
      "${pkgdir}/usr/share/licenses/${pkgname}/license.rst"
  else
    echo "WARNING: ${_srcroot}/docs/license.rst not found; license not installed"
  fi
}
