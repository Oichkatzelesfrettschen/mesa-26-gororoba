# SPDX-License-Identifier: MIT
# Instrumentation tools install independently of the selected Mesa system variant.
pkgname=mesa-gororoba-debug-tools
pkgver=26.2.0
pkgrel=3
epoch=2
replaces=('mesa-gororoba-gpu-debug-stack')
conflicts=('mesa-gororoba-gpu-debug-stack')
provides=("mesa-gororoba-gpu-debug-stack=${epoch}:${pkgver}-${pkgrel}")
pkgdesc='Meta-package: the RS482/r300 GPU debug stack -- umr-gororoba + radeon-KMD instrumentation tools (bpftrace/valgrind/gdb/radeontop/perf) + docs'
arch=('any')
url='https://github.com/Oichkatzelesfrettschen/mesa-26-gororoba'
license=('MIT')
# Tool versions follow their owning packages; GPU instrumentation targets radeon.
depends=(
  umr-gororoba
  bpftrace valgrind gdb strace radeontop perf lm_sensors
)
# Driver variants are optional mutually exclusive stock system replacements.
optdepends=(
  'mesa-gororoba-debug-optimized: the debugoptimized stock system driver (gdb/RADEON_DEBUG RCA)'
  'mesa-gororoba: the release stock system driver'
  'mesa-gororoba-debug-o0: the mutually exclusive stock -O0 system driver'
  'pwndbg: nicer gdb for driver state inspection'
  'heaptrack: allocation profiling in the draw path'
)
source=('r300-debug-tiers.md')
sha256sums=('e25ec398a47f03c6a2f4836fdfed76e1e2fdf7825a10749c61f6ae6f4644f74d')

package() {
  install -Dm644 "${srcdir}/r300-debug-tiers.md" \
    "${pkgdir}/usr/share/doc/${pkgname}/r300-debug-tiers.md"
}
