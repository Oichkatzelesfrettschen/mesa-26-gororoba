# terakan-distcc-no-rusticl-pump: clean-build lane for x130e.
#
# This is intentionally separate from the ccache/no-pump profile.  For
# C/C++, distcc-pump must see the original source and compiler command:
# do not put ccache or sccache in front of this lane.  Rust remains on
# sccache because it is a separate rustc chain and is not part of the
# distcc include-server path.
#
# terakan (Vulkan) and r600 (Gallium) are pure C and build fine.
# Only the gallium-rusticl OpenCL frontend is removed from this
# variant.  build-infra/Makefile defaults this profile to its own
# /usr/local/mesa-terakan-distcc-no-rusticl-pump prefix unless PREFIX
# is passed explicitly.

[project options]
buildtype           = 'debug'
b_ndebug            = 'false'

# r600 only -- same as terakan-distcc.
gallium-drivers     = ['r600']
vulkan-drivers      = ['amd_terascale']

# Rusticl DISABLED because upstream rusticl/pipe_screen bindgen
# output is opaque-stubbed on bindgen 0.71.1 + current Mesa pipe
# struct layout; rust source expects the reified binding.
# See rusticl-bindgen-drift.md in steinmarder docs/workspace/.
gallium-rusticl                = false

amd-use-llvm        = true
# draw-use-llvm dropped: triggers Mesa's gallivm/lp_bld_misc.cpp which
# requires llvm::SectionMemoryManager from LLVM ExecutionEngine.
# Debian's libLLVM-21.so does NOT export the SectionMemoryManager
# constructor symbol (linker reports `undefined reference to
# llvm::SectionMemoryManager::SectionMemoryManager(MemoryMapper*, bool)`).
# The Gallium draw module's LLVM JIT path is only required by llvmpipe
# and is irrelevant to r600+terakan; amd-use-llvm above remains true
# so the AMD compiler backend stays available.
draw-use-llvm       = false
# Wayland disabled: Mesa's src/egl/drivers/dri2/platform_wayland.c
# references `wl_fixes_interface` (wayland staging/fixes protocol),
# but Debian's wayland-protocols 1.44 package does NOT ship the
# staging/fixes/fixes.xml XML, so the generated symbol is undefined
# at link time.  terakan (Vulkan) does not need EGL or Wayland; r600
# Gallium uses X11/DRM platforms.  X11 platform stays enabled via
# `platforms` default-minus-wayland.
platforms           = ['x11']
gallium-extra-hud   = true
glx                 = 'auto'
