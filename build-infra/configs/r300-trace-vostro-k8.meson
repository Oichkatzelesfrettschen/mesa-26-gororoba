# r300-trace-vostro-k8: narrow GLX build for RS480 / R300 oracle runs.
#
# The Vostro 1000 target is an AMD Turion 64 X2 TL-66 system.  Clang
# identifies it as k8-sse3; keep that in the sourced environment so
# remote distcc compilers never emit newer host instructions.

[project options]
buildtype = 'debugoptimized'

platforms = ['x11']
gallium-drivers = ['r300']
vulkan-drivers = []

gallium-rusticl = false
llvm = 'disabled'
draw-use-llvm = false

glx = 'dri'
egl = 'disabled'
gbm = 'disabled'
gles1 = 'disabled'
gles2 = 'disabled'
glvnd = 'disabled'
valgrind = 'disabled'
libunwind = 'disabled'
perfetto = false
