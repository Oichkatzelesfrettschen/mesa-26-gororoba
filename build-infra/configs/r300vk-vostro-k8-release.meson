# r300vk-vostro-k8-release: Gallium-backed r300vk ICD for RS482/RS485 validation.
# Canonical validation host: Vostro 1000, RS482/RS485 device 1002:5974.
#
# This production lane installs beside the r300 Gallium oracle under
# /opt/local/mesa-26-gororoba.  LLVM stays disabled because r300g does not need
# it, while r300vk-gallium-backend keeps physical-device and submit queries
# wired through the r300g screen and pipe_context surfaces.

[project options]
buildtype = 'release'
b_ndebug = 'true'

platforms = ['x11']
gallium-drivers = ['r300']
vulkan-drivers = ['amd_r300']
r300vk-gallium-backend = true
tools = ['r300']

gallium-rusticl = false
llvm = 'disabled'
draw-use-llvm = false

opengl = false
glx = 'disabled'
egl = 'disabled'
gbm = 'disabled'
gles1 = 'disabled'
gles2 = 'disabled'
glvnd = 'disabled'
valgrind = 'disabled'
libunwind = 'disabled'
perfetto = false
