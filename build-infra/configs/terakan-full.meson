# terakan-full: canonical 'full Mesa + terakan' debug build.
#
# Derived from the five equivalent build dirs in the pre-synthesis
# gororoba (build-terakan-{debug,plain,spiwatch,vtxfetch,vtxfetch-cachefix})
# which all carried this exact option set.  See
# ../../../steinmarder/docs/workspace/mesa-fork-synthesis.md.

[binaries]
c   = ['ccache', 'clang-21']
cpp = ['ccache', 'clang++-21']
rust = ['sccache', 'rustc']
llvm-config = 'llvm-config-21'

[project options]
buildtype           = 'debug'
b_ndebug            = 'false'

# Gallium drivers: r600 fork (the target) plus upstream refs.
gallium-drivers     = ['r600', 'zink', 'softpipe', 'llvmpipe']

# Vulkan drivers: our terakan fork.
vulkan-drivers      = ['amd_terascale']

# Rusticl (OpenCL over Gallium): enabled with auto-detected driver pool.
gallium-rusticl                = true
gallium-rusticl-enable-drivers = ['auto']

# AMD compiler uses LLVM, HUD available for profiling overlays, VA for
# video accel decode tests (Evergreen UVD2).
amd-use-llvm        = true
gallium-extra-hud   = true
gallium-va          = 'enabled'

# GLX stack: auto-pick dri vs direct (upstream Mesa default is sane).
glx                 = 'auto'
