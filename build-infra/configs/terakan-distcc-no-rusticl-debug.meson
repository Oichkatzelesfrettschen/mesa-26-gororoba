# terakan-distcc-no-rusticl-debug: same component set as
# terakan-distcc-no-rusticl, compiled -O0 -g with full assertions
# live and install-time strip disabled.  Use for gdb / trace-cmd /
# bpftrace work against libvulkan_terascale.so.  The release
# variant installs to /usr/local/mesa-26-gororoba/; this variant
# installs to /usr/local/mesa-26-gororoba-debug/.  Both prefixes
# coexist; operators select via VK_ICD_FILENAMES.

[project options]
buildtype           = 'debug'
b_ndebug            = 'false'
werror              = true
strip               = false

gallium-drivers     = ['r600']
vulkan-drivers      = ['amd_terascale']

gallium-rusticl     = false

amd-use-llvm        = true
gallium-extra-hud   = true
glx                 = 'auto'
