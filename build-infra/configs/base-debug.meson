# base-debug: stock Mesa reference build (NO terakan).  Kept so the
# terakan work can be regression-compared against upstream Mesa
# behaviour on the same hardware.  Derived from build-debug/.
# See ../../../steinmarder/docs/workspace/mesa-fork-synthesis.md.

[binaries]
c   = ['/usr/bin/ccache', '/usr/bin/clang-21']
cpp = ['/usr/bin/ccache', '/usr/bin/clang++-21']
rust = ['/home/eirikr/.local/bin/sccache', '/home/eirikr/.rustup/toolchains/stable-x86_64-unknown-linux-gnu/bin/rustc']

[project options]
buildtype           = 'debug'

gallium-drivers     = ['r600', 'softpipe', 'llvmpipe']
vulkan-drivers      = []

amd-use-llvm        = true
glx                 = 'dri'
