# 3_r300_full_debug_optimized_x86_64v1-clang22-distcc-cache: the DEFAULT debug
# tier and the ONLY debug tier allowed to own the system /usr Mesa.  Same
# maximal-feature r300 API/loader surface and the same x86-64-v1/clang22/
# distcc-cache lane as the 4_ release profile.  Beyond release it carries
# debug-only instrumentation: debugoptimized buildtype with live assertions, frame
# pointers, -g3, valgrind + libunwind annotations, the perfetto track-event
# timeline, the standalone nir/glsl compiler tools plus dlclose-skip, the in-tree
# unit tests, the anti-lag/device-select implicit layers, an /opt overlay, and
# the full platform
# set.  It carries the whole restored r300 surface -- the r300 gallium driver and
# ati_r300 Vulkan ICD, the gallium-va MPEG-2 decode, and the gallium-xa 2D/Xv
# frontend -- with assertions live.  It deliberately keeps r300's SW-TCL on the C
# draw interpreter (no llvmpipe, draw-use-llvm=false) so the vertex path stays
# instrumentable.  Conformance and silicon evidence use the 4_ release profile.
#
# Tier map (renumbered by priority; all build the same full r300 surface):
#   1_ debug-asan      -- ASan+UBSan+extended, -O0, /opt + wrapper ONLY.
#   2_ debug-o0         -- -O0 -g asserts, no sanitizer, /opt + run-wrapper.
#   3_ (THIS) debug-opt -- -O2 -g3 asserts; the DEFAULT debug, /usr-capable.
#   4_ release          -- optimized, no asserts, /usr.
#
# Why -O2 debugoptimized is the right daily-driver debug: at -O2 the control flow
# stays close enough to a real build to expose optimizer-sensitive driver bugs,
# while -g3 + frame pointers keep gdb backtraces landing on the true fault site.
# It is the package (mesa-gororoba-debug-optimized) that BECOMES the system /usr
# Mesa on the Vostro; the 1_/2_ sanitizer/-O0 tiers stay /opt-scoped, and the 4_
# release stays the reserved promotion target.
#
# Install this to the -debug prefix (/opt/local/mesa-gororoba-debug-optimized) so the
# release and debug artifacts never share object files or install paths.
#
# Feature set, exclusions, and HOSTENV pairing are identical to profile 4_; see
# that file's header for the full rationale.

[built-in options]
buildtype = 'debugoptimized'
b_ndebug = 'false'
# -fno-emulated-tls matches profile 4_ (the GL stack's libglapi needs native
# TLS under clang).  The debug profile forces -fno-omit-frame-pointer: clang at
# -O2 (debugoptimized) drops the frame pointer by default, which breaks
# gdb/libunwind RCA backtraces, so pin it on.
c_args = ['-march=x86-64', '-mtune=generic', '-D_FORTIFY_SOURCE=2', '-fno-emulated-tls', '-fno-omit-frame-pointer', '-fexceptions', '-fstack-protector-strong', '-fstack-clash-protection', '-fcf-protection', '-Wformat', '-Werror=format-security']
cpp_args = ['-march=x86-64', '-mtune=generic', '-D_FORTIFY_SOURCE=2', '-fno-emulated-tls', '-fno-omit-frame-pointer', '-fexceptions', '-fstack-protector-strong', '-fstack-clash-protection', '-fcf-protection', '-Wformat', '-Werror=format-security', '-Wp,-D_GLIBCXX_ASSERTIONS']
c_link_args = ['-Wl,-O1', '-Wl,--sort-common', '-Wl,--as-needed', '-Wl,-z,relro']
cpp_link_args = ['-Wl,-O1', '-Wl,--sort-common', '-Wl,--as-needed', '-Wl,-z,relro']

[project options]
# Window-system platforms only.  Current Mesa's platforms option accepts just
# the window systems (x11, wayland, ...); the DRM-native and surfaceless EGL
# platforms are no longer listed here -- they build unconditionally with
# egl=enabled and the default is chosen by egl-native-platform (set to 'surfaceless'
# below for headless deqp/piglit and renderD128-only Vulkan).  XCB is Mesa's
# internal transport for the x11 platform and is not a separate option.
platforms = ['x11', 'wayland']
# r300 plus zink: zink rides the ati_r300 (r3v) Vulkan ICD to expose GL atop
# Vulkan on RS482, the GL-on-Vulkan lane this debug build is the install target
# for.  No llvmpipe -- building it would force draw-use-llvm=true and route
# r300's SW-TCL through the gallivm JIT instead of the C draw interpreter this
# profile instruments; zink itself needs no llvm.
gallium-drivers = ['r300', 'zink']
vulkan-drivers = ['ati_r300']
# The Gallium-free native ICD (libvulkan_r3v_native); its drm-shim harness
# and separation audits run from this build's test graph.
r3v-native-backend = true

# Maximal OpenGL/GLES surface (desktop GL, GLES1, GLES2).
opengl = true
gles1 = 'enabled'
gles2 = 'enabled'

# Loader and window-system surfaces (GLVND, GLX-DRI, EGL, GBM).
glvnd = 'enabled'
glx = 'dri'
egl = 'enabled'
egl-native-platform = 'surfaceless'
gbm = 'enabled'

# r300 tooling, on-disk shader cache, and the Gallium HUD with lm-sensors.
shader-cache = 'enabled'
gallium-extra-hud = true
lmsensors = 'enabled'

# RS482 has caps.has_tcl=false, so r300 routes all vertex work through the
# Gallium draw module (SW-TCL) -- r300_context.c draw_create().  Keep
# draw-use-llvm=false so that path stays the C interpreter (draw_context.c
# DRAW_USE_LLVM selects the gallivm JIT only when true): gdb/valgrind
# step-through and the surface to build/measure a custom hybrid TCL on.  With no
# llvmpipe, llvm is otherwise unused here, so leave it disabled to stay lean.
llvm = 'disabled'
draw-use-llvm = false
gallium-rusticl = false

# Maximal debug instrumentation (debug profile only; 1_ release stays lean).
# valgrind builds the VALGRIND_* client-request annotations so memcheck can see
# BO/transfer lifetimes; libunwind gives reliable symbolized stack traces for
# u_debug_stack and gdb.  Both deps are present on the Vostro.
valgrind = 'enabled'
libunwind = 'enabled'

# Perfetto track-event timeline.  r300/radeon is not a perfetto GPU datasource
# (only panfrost/intel/freedreno are), so this captures the CPU-side driver
# timeline, not GPU counters; datasources stays 'auto'.  If Meson aborts configure
# on the perfetto subproject install-data tagging, drop perfetto back to false --
# that is a toolchain blocker, not an r300 one.
perfetto = true
datasources = ['auto']

# Standalone compiler RCA tools: nir and glsl build the offline NIR/GLSL
# compilers (so an r300 RC fault can be reproduced off the X server), and
# dlclose-skip keeps dlopened drivers resident so a gdb backtrace through the
# pipe-loaded r300 driver keeps its symbols.  drm-shim builds
# libradeon_noop_drm_shim, the render-node model the r3v native triangle-cell
# harness preloads.
tools = ['nir', 'glsl', 'dlclose-skip', 'drm-shim']

# Build the in-tree unit tests (the r300 compiler and NIR tests), so a compiler
# fault can be reproduced by a deterministic test instead of only through the
# live driver.
build-tests = true

# The package activates anti-lag and device-select as Arch's complete implicit
# layer pair.  Overlay remains available only through the /opt debug prefix.
vulkan-layers = ['anti-lag', 'device-select', 'overlay']

# The restored r300 feature surface this debug lane must instrument: gallium-va
# MPEG-2 decode (the pure-NIR g3dvl kernels), the H.264 decode back half on the
# same g3dvl path (h264dec sets VIDEO_CODEC_H264DEC so the gated r300_video.c
# H.264 path compiles; it stays fail-closed at runtime behind
# R300_H264_EXPERIMENTAL and an entropy provider), and the gallium-xa 2D/Xv
# frontend (xa_nir.c).  These are the "built back up" extras; the debug profile
# carries them with assertions live so an RC, H.264, or xa fault lands on its
# true site.
video-codecs = ['mpeg12dec', 'h264dec']
gallium-va = 'enabled'
gallium-xa = true

# Warnings are defects in every configured lane.
werror = true
