# r300-vostro-k8-release: narrow GLX release build for RS480/R300 oracle runs.
# Canonical install prefix: /opt/local/mesa-26-gororoba
#
# Target: Vostro 1000, AMD Turion 64 X2 TL-66 (k8-sse3).
# LLVM disabled -- r300 Gallium needs no LLVM backend.

[project options]
buildtype = 'release'
b_ndebug = 'true'

platforms = ['x11']
gallium-drivers = ['r300']
vulkan-drivers = []
tools = ['r300']

gallium-rusticl = false
llvm = 'disabled'
draw-use-llvm = false

glx = 'dri'
egl = 'disabled'
gbm = 'disabled'
gles1 = 'disabled'
gles2 = 'disabled'
glvnd = 'disabled'
valgrind = 'disabled'
libunwind = 'disabled'
perfetto = false
