# r300-egl-gbm-trace-vostro-k8: headless EGL/GBM r300 build with R300_TRACE
# for RS480/RS482 oracle PM4 capture.  Derived from r300-trace-vostro-k8 by
# enabling egl + gbm so a GBM-device EGL context reaches the r300 gallium
# driver over /dev/dri/renderD128, bypassing the DRI2-only GLX path that
# Mesa's DRIL client cannot drive on this host.  EGL_DEFAULT_DISPLAY uses the
# DRM native platform so simple EGL probes do not accidentally require X11.
# llvm stays disabled so there is NO llvmpipe fallback: the probe gets hardware
# r300 or it fails loudly.
# R300_TRACE lives in the radeon winsys (radeon_drm_cs.c), present with any
# gallium-drivers=r300 build.

[project options]
buildtype = 'debugoptimized'

platforms = ['x11']
gallium-drivers = ['r300']
vulkan-drivers = []
tools = ['r300']

gallium-rusticl = false
llvm = 'disabled'
draw-use-llvm = false

glx = 'dri'
egl = 'enabled'
egl-native-platform = 'drm'
gbm = 'enabled'
gles1 = 'disabled'
gles2 = 'enabled'
glvnd = 'disabled'
valgrind = 'disabled'
libunwind = 'disabled'
perfetto = false
