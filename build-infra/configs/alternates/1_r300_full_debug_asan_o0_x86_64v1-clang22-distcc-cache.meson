# 1_r300_full_debug_asan_o0: the PRIME r300 tier -- the highest-information
# RCA build, never a system Mesa.  AddressSanitizer + UndefinedBehaviorSanitizer
# with the extended sanitizer set, at -O0 so every source line keeps its own
# machine code (no inlining or optimizer folding) and an ASan/UBSan report or a
# gdb step lands on the source exactly as written.  -g3 macro-aware debug info,
# live asserts, frame pointers, sibling-call folding off, report-merging off.
#
# Tier map (renumbered by priority; all build the same full r300 surface):
#   1_ (THIS) debug-asan   -- ASan+UBSan+extended, -O0, /opt + wrapper ONLY.
#   2_ debug-o0             -- -O0 max-debug, no sanitizer, /opt + wrapper.
#   3_ debug-optimized      -- -O2 -g3 asserts, the only debug tier allowed /usr.
#   4_ release              -- optimized, no asserts, no sanitizer, /usr.
#
# LOCKED SAFETY INVARIANT: this profile and its mesa-gororoba-debug-asan package
# must NEVER become the system Mesa.  An ASan-instrumented libGL/libvulkan as the
# /usr default aborts every GL/VK client ('ASan runtime does not come first') and
# can black-screen the login session.  The package installs ONLY to
# /opt/mesa-gororoba-debug-asan, never symlinks into /usr, never
# provides/conflicts/replaces mesa, drops no ld.so.conf.d activation, and is
# reached only through mesa-gororoba-debug-asan-run.  -O0 over -O1 is the
# deliberate "microscope" choice: stepping fidelity beats runtime speed because
# this tier is single-case forensic RCA, never broad conformance or a desktop
# driver (use 3_/4_ for those).
#
# b_lundef=false (the sanitizer runtimes need undefined symbols at link);
# _FORTIFY_SOURCE is dropped because it conflicts with ASan.  The explicit extra
# sanitizer flags below cover checks outside Clang's undefined group: pointer-pair
# validation, integer (signed+unsigned/shift), implicit conversions, local-bounds,
# nullability, and float divide-by-zero (detect_invalid_pointer_pairs=2 at runtime
# activates the pointer-pair checks).  TSAN is mutually exclusive with ASAN and
# MSAN needs every dependent library instrumented, so those remain separate lanes.

[built-in options]
buildtype = 'debug'
# The full sanitizer set as a free-form array (Meson >= 1.8; this host is 1.11).
# Meson joins these into one -fsanitize=... on BOTH compile and link, so the
# address-dependent checks (pointer-compare/subtract) always see -fsanitize=address
# -- unlike putting them in c_args, where the compiler sanity check sees them
# without address and rejects them ("only allowed with -fsanitize=address").
# address pulls in use-after-scope and use-after-return by default on clang.
# undefined plus the extra members cover the checks outside Clang's undefined
# group: integer (signed+unsigned overflow/shift), implicit-conversion,
# local-bounds, nullability, float divide-by-zero, and the pointer-pair checks
# (detect_invalid_pointer_pairs=2 activates the latter at runtime).
b_sanitize = ['address', 'undefined', 'pointer-compare', 'pointer-subtract', 'integer', 'implicit-conversion', 'local-bounds', 'nullability', 'float-divide-by-zero']
b_lundef = 'false'
b_ndebug = 'false'
werror = true
# buildtype='debug' already gives -O0 -g; -g3 upgrades to macro-aware debug info.
# -fno-emulated-tls matches profiles 3_/4_ (the GL stack's libglapi needs native
# TLS under clang).  Frame pointers on, sibling-call folding off so ASan/UBSan
# reports and gdb line up with the source under RCA.  The -fsanitize flags live in
# b_sanitize above, NOT here, so the compiler sanity check (which sees only c_args)
# stays sanitizer-free and the address dependency is never violated.
c_args = ['-march=x86-64', '-mtune=generic', '-g3', '-fno-emulated-tls', '-fno-omit-frame-pointer', '-fno-optimize-sibling-calls', '-fexceptions', '-fstack-protector-all', '-fstack-clash-protection', '-fcf-protection', '-Wformat', '-Werror=format-security']
cpp_args = ['-march=x86-64', '-mtune=generic', '-g3', '-fno-emulated-tls', '-fno-omit-frame-pointer', '-fno-optimize-sibling-calls', '-fexceptions', '-fstack-protector-all', '-fstack-clash-protection', '-fcf-protection', '-Wformat', '-Werror=format-security', '-Wp,-D_GLIBCXX_ASSERTIONS']
c_link_args = ['-Wl,-O1', '-Wl,--sort-common', '-Wl,--as-needed', '-Wl,-z,relro']
cpp_link_args = ['-Wl,-O1', '-Wl,--sort-common', '-Wl,--as-needed', '-Wl,-z,relro']

[project options]
# Window-system platforms only.  Current Mesa's platforms option accepts just
# the window systems (x11, wayland, ...); the DRM-native and surfaceless EGL
# platforms are no longer listed here -- they build unconditionally with
# egl=enabled and the default is chosen by egl-native-platform (set to 'surfaceless'
# below for headless deqp/piglit and renderD128-only Vulkan).  XCB is Mesa's
# internal transport for the x11 platform and is not a separate option.
platforms = ['x11', 'wayland']
# r300 plus zink: zink rides the ati_r300 (r3v) Vulkan ICD to expose GL atop
# Vulkan on RS482, the GL-on-Vulkan lane this debug build is the install target
# for.  No llvmpipe -- building it would force draw-use-llvm=true and route
# r300's SW-TCL through the gallivm JIT instead of the C draw interpreter this
# profile instruments; zink itself needs no llvm.
gallium-drivers = ['r300', 'zink']
vulkan-drivers = ['ati_r300']

# Maximal OpenGL/GLES surface (desktop GL, GLES1, GLES2).
opengl = true
gles1 = 'enabled'
gles2 = 'enabled'

# Loader and window-system surfaces (GLVND, GLX-DRI, EGL, GBM).
glvnd = 'enabled'
glx = 'dri'
egl = 'enabled'
egl-native-platform = 'surfaceless'
gbm = 'enabled'

# r300 tooling, on-disk shader cache, and the Gallium HUD with lm-sensors.
shader-cache = 'enabled'
gallium-extra-hud = true
lmsensors = 'enabled'

# RS482 has caps.has_tcl=false, so r300 routes all vertex work through the
# Gallium draw module (SW-TCL) -- r300_context.c draw_create().  Keep
# draw-use-llvm=false so that path stays the C interpreter (draw_context.c
# DRAW_USE_LLVM selects the gallivm JIT only when true): gdb/valgrind
# step-through and the surface to build/measure a custom hybrid TCL on.  With no
# llvmpipe, llvm is otherwise unused here, so leave it disabled to stay lean.
llvm = 'disabled'
draw-use-llvm = false
gallium-rusticl = false

# Maximal debug instrumentation (debug profile only; 1_ release stays lean).
# valgrind builds the VALGRIND_* client-request annotations so memcheck can see
# BO/transfer lifetimes; libunwind gives reliable symbolized stack traces for
# u_debug_stack and gdb.  Both deps are present on the Vostro.
valgrind = 'enabled'
libunwind = 'enabled'

# Perfetto track-event timeline.  r300/radeon is not a perfetto GPU datasource
# (only panfrost/intel/freedreno are), so this captures the CPU-side driver
# timeline, not GPU counters; datasources stays 'auto'.  If Meson aborts configure
# on the perfetto subproject install-data tagging, drop perfetto back to false --
# that is a toolchain blocker, not an r300 one.
perfetto = true
datasources = ['auto']

# Standalone compiler RCA tools: nir and glsl build the offline NIR/GLSL
# compilers (so an r300 RC fault can be reproduced off the X server), and
# dlclose-skip keeps dlopened drivers resident so a gdb backtrace through the
# pipe-loaded r300 driver keeps its symbols.
tools = ['nir', 'glsl', 'dlclose-skip']

# Build the in-tree unit tests (the r300 compiler and NIR tests), so a compiler
# fault can be reproduced by a deterministic test instead of only through the
# live driver.
build-tests = true

# r3v debug layers: overlay (the on-screen HUD) and device-select.  These are
# the mesa-shipped layers; Khronos validation is a separate package.
vulkan-layers = ['overlay', 'device-select']

# The restored r300 feature surface this debug lane must instrument: gallium-va
# MPEG-2 decode (the pure-NIR g3dvl kernels), the H.264 decode back half on the
# same g3dvl path (h264dec sets VIDEO_CODEC_H264DEC so the gated r300_video.c
# H.264 path compiles; it stays fail-closed at runtime behind
# R300_H264_EXPERIMENTAL and an entropy provider), and the gallium-xa 2D/Xv
# frontend (xa_nir.c).  These are the "built back up" extras; the debug profile
# carries them with assertions live so an RC, H.264, or xa fault lands on its
# true site.
video-codecs = ['mpeg12dec', 'h264dec']
gallium-va = 'enabled'
gallium-xa = true

# Warnings are defects in every configured lane.
werror = true
