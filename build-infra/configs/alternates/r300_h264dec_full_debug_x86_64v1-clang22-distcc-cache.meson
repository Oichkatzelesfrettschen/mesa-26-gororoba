# r300 full debug profile with the experimental H.264 decoder built in.
#
# Identical to 3_r300_full_debug_optimized_x86_64v1-clang22-distcc-cache except
# video-codecs adds h264dec, so VIDEO_CODEC_H264DEC=1 and the gated H.264
# decode skeleton (vl_h264_decoder, vl_h264_vld_provider, the r300_video.c
# advertisement) compiles and lands in compile_commands.json.  The runtime path
# stays fail-closed: H.264 is advertised only when R300_H264_EXPERIMENTAL is set
# and an entropy provider exists, and no provider exists yet.

[built-in options]
buildtype = 'debugoptimized'
b_ndebug = 'false'
c_args = ['-march=x86-64', '-mtune=generic', '-D_FORTIFY_SOURCE=2', '-fno-emulated-tls', '-fno-omit-frame-pointer', '-fexceptions', '-fstack-protector-strong', '-fstack-clash-protection', '-fcf-protection', '-Wformat', '-Werror=format-security']
cpp_args = ['-march=x86-64', '-mtune=generic', '-D_FORTIFY_SOURCE=2', '-fno-emulated-tls', '-fno-omit-frame-pointer', '-fexceptions', '-fstack-protector-strong', '-fstack-clash-protection', '-fcf-protection', '-Wformat', '-Werror=format-security', '-Wp,-D_GLIBCXX_ASSERTIONS']
c_link_args = ['-Wl,-O1', '-Wl,--sort-common', '-Wl,--as-needed', '-Wl,-z,relro']
cpp_link_args = ['-Wl,-O1', '-Wl,--sort-common', '-Wl,--as-needed', '-Wl,-z,relro']

[project options]
platforms = ['x11', 'wayland']
gallium-drivers = ['r300', 'zink', 'softpipe']
vulkan-drivers = ['ati_r300']
opengl = true
gles1 = 'enabled'
gles2 = 'enabled'
glvnd = 'enabled'
glx = 'dri'
egl = 'enabled'
egl-native-platform = 'surfaceless'
gbm = 'enabled'
shader-cache = 'enabled'
gallium-extra-hud = true
lmsensors = 'enabled'
llvm = 'disabled'
draw-use-llvm = false
gallium-rusticl = false
valgrind = 'enabled'
libunwind = 'enabled'
perfetto = true
datasources = ['auto']
tools = ['nir', 'glsl', 'dlclose-skip']
build-tests = true
vulkan-layers = ['overlay', 'device-select']
video-codecs = ['mpeg12dec', 'h264dec']
gallium-va = 'enabled'
gallium-xa = true

# Warnings are defects in every configured lane.
werror = true
