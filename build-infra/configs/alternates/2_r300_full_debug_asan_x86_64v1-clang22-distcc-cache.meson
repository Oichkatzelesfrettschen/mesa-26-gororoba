# 2_r300_full_debug_x86_64v1-clang22-distcc-cache: the maximal-feature r300
# DEBUG sibling of 1_r300_full_release_x86_64v1-clang22-distcc-cache.  Same r300
# API/loader surface and same x86-64-v1/clang22/distcc-cache lane.  Beyond the
# release profile it carries debug-only instrumentation surfaces: debugoptimized
# buildtype with live assertions, frame pointers, valgrind + libunwind
# annotations, the perfetto track-event timeline, the standalone nir/glsl
# compiler tools plus dlclose-skip, the in-tree unit tests, the overlay and
# device-select vulkan layers, and the full platform set.  It carries the whole
# restored r300 surface -- the r300 gallium driver and amd_r300 Vulkan ICD, the
# gallium-va MPEG-2 decode, and the gallium-xa 2D/Xv frontend -- with assertions
# live.  It deliberately keeps r300's SW-TCL on the C draw interpreter (no
# llvmpipe, draw-use-llvm=false) so the vertex path stays instrumentable.
# Conformance and silicon evidence use the release profile.
#
# Why a separate debug profile: driver RCA and shader disassembly need assertions
# live (b_ndebug='false') and a debugoptimized build (-O2 -g, real frame
# pointers, intact error paths) so a gdb backtrace through r300_emit, the blitter,
# and the r300vk queue lands on the true fault site instead of an optimizer-folded
# address.  Conformance and silicon evidence use the release profile instead, so
# the assertion instrumentation never contaminates a pass/fail baseline.
#
# Install this to the -debug prefix (/opt/local/mesa-26-gororoba-debug) so the
# release and debug artifacts never share object files or install paths.
#
# Feature set, exclusions, and HOSTENV pairing are identical to profile 1_; see
# that file's header for the full rationale.

[built-in options]
buildtype = 'debugoptimized'
b_sanitize = 'address'
b_lundef = 'false'
optimization = '1'
b_ndebug = 'false'
# -fno-emulated-tls matches profile 1_ (the GL stack's libglapi needs native
# TLS under clang).  The debug profile forces -fno-omit-frame-pointer: clang at
# -O2 (debugoptimized) drops the frame pointer by default, which breaks
# gdb/libunwind RCA backtraces, so pin it on.
c_args = ['-march=x86-64', '-mtune=generic', '-fno-emulated-tls', '-fno-omit-frame-pointer', '-fexceptions', '-fstack-protector-strong', '-fstack-clash-protection', '-fcf-protection', '-Wformat', '-Werror=format-security']
cpp_args = ['-march=x86-64', '-mtune=generic', '-fno-emulated-tls', '-fno-omit-frame-pointer', '-fexceptions', '-fstack-protector-strong', '-fstack-clash-protection', '-fcf-protection', '-Wformat', '-Werror=format-security', '-Wp,-D_GLIBCXX_ASSERTIONS']
c_link_args = ['-Wl,-O1', '-Wl,--sort-common', '-Wl,--as-needed', '-Wl,-z,relro']
cpp_link_args = ['-Wl,-O1', '-Wl,--sort-common', '-Wl,--as-needed', '-Wl,-z,relro']

[project options]
# Window-system platforms only.  Current Mesa's platforms option accepts just
# the window systems (x11, wayland, ...); the DRM-native and surfaceless EGL
# platforms are no longer listed here -- they build unconditionally with
# egl=enabled and the default is chosen by egl-native-platform (set to 'drm'
# below for headless deqp/piglit and renderD128-only Vulkan).  XCB is Mesa's
# internal transport for the x11 platform and is not a separate option.
platforms = ['x11', 'wayland']
# r300 plus zink: zink rides the amd_r300 (r300vk) Vulkan ICD to expose GL atop
# Vulkan on RS482, the GL-on-Vulkan lane this debug build is the install target
# for.  No llvmpipe -- building it would force draw-use-llvm=true and route
# r300's SW-TCL through the gallivm JIT instead of the C draw interpreter this
# profile instruments; zink itself needs no llvm.
gallium-drivers = ['r300', 'zink']
vulkan-drivers = ['amd_r300']
r300vk-gallium-backend = true

# Maximal OpenGL/GLES surface (desktop GL, GLES1, GLES2).
opengl = true
gles1 = 'enabled'
gles2 = 'enabled'

# Loader and window-system surfaces (GLVND, GLX-DRI, EGL, GBM).
glvnd = 'enabled'
glx = 'dri'
egl = 'enabled'
egl-native-platform = 'drm'
gbm = 'enabled'

# r300 tooling, on-disk shader cache, and the Gallium HUD with lm-sensors.
shader-cache = 'enabled'
gallium-extra-hud = true
lmsensors = 'enabled'

# RS482 has caps.has_tcl=false, so r300 routes all vertex work through the
# Gallium draw module (SW-TCL) -- r300_context.c draw_create().  Keep
# draw-use-llvm=false so that path stays the C interpreter (draw_context.c
# DRAW_USE_LLVM selects the gallivm JIT only when true): gdb/valgrind
# step-through and the surface to build/measure a custom hybrid TCL on.  With no
# llvmpipe, llvm is otherwise unused here, so leave it disabled to stay lean.
llvm = 'disabled'
draw-use-llvm = false
gallium-rusticl = false

# Maximal debug instrumentation (debug profile only; 1_ release stays lean).
# valgrind builds the VALGRIND_* client-request annotations so memcheck can see
# BO/transfer lifetimes; libunwind gives reliable symbolized stack traces for
# u_debug_stack and gdb.  Both deps are present on the Vostro.
valgrind = 'enabled'
libunwind = 'enabled'

# Perfetto track-event timeline.  r300/radeon is not a perfetto GPU datasource
# (only panfrost/intel/freedreno are), so this captures the CPU-side driver
# timeline, not GPU counters; datasources stays 'auto'.  If Meson aborts configure
# on the perfetto subproject install-data tagging, drop perfetto back to false --
# that is a toolchain blocker, not an r300 one.
perfetto = true
datasources = ['auto']

# Standalone compiler RCA tools: nir and glsl build the offline NIR/GLSL
# compilers (so an r300 RC fault can be reproduced off the X server), and
# dlclose-skip keeps dlopened drivers resident so a gdb backtrace through the
# pipe-loaded r300 driver keeps its symbols.
tools = ['nir', 'glsl', 'dlclose-skip']

# Build the in-tree unit tests (the r300 compiler and NIR tests), so a compiler
# fault can be reproduced by a deterministic test instead of only through the
# live driver.
build-tests = true

# r300vk debug layers: overlay (the on-screen HUD) and device-select.  These are
# the mesa-shipped layers; Khronos validation is a separate package.
vulkan-layers = ['overlay', 'device-select']

# The restored r300 feature surface this debug lane must instrument: gallium-va
# MPEG-2 decode (the pure-NIR g3dvl kernels), the H.264 decode back half on the
# same g3dvl path (h264dec sets VIDEO_CODEC_H264DEC so the gated r300_video.c
# H.264 path compiles; it stays fail-closed at runtime behind
# R300_H264_EXPERIMENTAL and an entropy provider), and the gallium-xa 2D/Xv
# frontend (xa_nir.c).  These are the "built back up" extras; the debug profile
# carries them with assertions live so an RC, H.264, or xa fault lands on its
# true site.
video-codecs = ['mpeg12dec', 'h264dec']
gallium-va = 'enabled'
gallium-xa = true
