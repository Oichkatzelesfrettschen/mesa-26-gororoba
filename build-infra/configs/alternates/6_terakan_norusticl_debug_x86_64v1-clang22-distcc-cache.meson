# 6_terakan_norusticl_debug_x86_64v1-clang22-distcc-cache: identical to
# 4_terakan_full_debug_x86_64v1-clang22-distcc-cache except Rusticl/OpenCL
# is disabled.  Use this profile when bindgen drift or a Rust toolchain gap
# makes Rusticl unbuildable while r600 + zink + softpipe + llvmpipe + terascale
# Vulkan must still ship in debug form.
#
# When Rusticl builds cleanly, prefer 4_terakan_full_debug.  This profile
# exists so the terakan debug stack is never held hostage by an upstream
# Rust/bindgen API break.  All other options, compiler flags, HOSTENV, and
# install prefix are identical to profile 4_.  See that file's header for the
# full rationale.

[built-in options]
buildtype = 'debugoptimized'
b_ndebug = 'false'
# -fno-emulated-tls matches profile 4_ (the GL stack's libglapi needs native
# TLS under clang).  The debug profile forces -fno-omit-frame-pointer: clang at
# -O2 (debugoptimized) drops the frame pointer by default, which breaks
# gdb/libunwind RCA backtraces, so pin it on.
c_args = ['-march=x86-64', '-mtune=generic', '-D_FORTIFY_SOURCE=2', '-fno-emulated-tls', '-fno-omit-frame-pointer', '-fexceptions', '-fstack-protector-strong', '-fstack-clash-protection', '-fcf-protection', '-Wformat', '-Werror=format-security']
cpp_args = ['-march=x86-64', '-mtune=generic', '-D_FORTIFY_SOURCE=2', '-fno-emulated-tls', '-fno-omit-frame-pointer', '-fexceptions', '-fstack-protector-strong', '-fstack-clash-protection', '-fcf-protection', '-Wformat', '-Werror=format-security', '-Wp,-D_GLIBCXX_ASSERTIONS']
c_link_args = ['-Wl,-O1', '-Wl,--sort-common', '-Wl,--as-needed', '-Wl,-z,relro']
cpp_link_args = ['-Wl,-O1', '-Wl,--sort-common', '-Wl,--as-needed', '-Wl,-z,relro']

[project options]
# Maximal terakan debug stack without Rusticl: r600 hardware + zink/softpipe/
# llvmpipe software fallbacks, plus the amd_terascale Vulkan ICD.
platforms = ['x11', 'wayland']
gallium-drivers = ['r600', 'zink', 'softpipe', 'llvmpipe']
vulkan-drivers = ['amd_terascale']
llvm = 'enabled'
amd-use-llvm = true
draw-use-llvm = true

# Maximal OpenGL/GLES surface (desktop GL, GLES1, GLES2).
opengl = true
gles1 = 'enabled'
gles2 = 'enabled'

# Loader and window-system surfaces (GLVND, GLX-DRI, EGL, GBM).
glvnd = 'enabled'
glx = 'dri'
egl = 'enabled'
egl-native-platform = 'surfaceless'
gbm = 'enabled'

# r600 tooling, on-disk shader cache, and the Gallium HUD with lm-sensors.
shader-cache = 'enabled'
gallium-extra-hud = true
lmsensors = 'enabled'

# Rusticl disabled: use this profile when bindgen drift blocks the Rust
# front-end build.  gallium-rusticl-enable-drivers is omitted because it has no
# effect when gallium-rusticl=false.
gallium-rusticl = false

# gallium-va video decode (UVD / VAVP on PALM) and gallium-xa 2D/Xv frontend.
gallium-va = 'enabled'
video-codecs = ['all']
gallium-xa = true

# Promote warnings to errors in this project's new and modified code.
werror = true

# Maximal debug instrumentation (debug profile only; release stays lean).
valgrind = 'enabled'
libunwind = 'enabled'

# Perfetto track-event timeline (CPU-side driver timeline for r600).
perfetto = true
datasources = ['auto']

# Standalone compiler RCA tools and in-tree unit tests.
tools = ['nir', 'glsl', 'dlclose-skip']
build-tests = true

# r600/terakan debug layers: overlay (the on-screen HUD) and device-select.
vulkan-layers = ['overlay', 'device-select']
