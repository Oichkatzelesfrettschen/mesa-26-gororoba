# cachyos-cross-rusticl-musl-x86-64-baseline.env
#
# Companion env file for build-infra/configs/
#   terakan-cachyos-cross-rusticl-musl-x86-64-baseline.meson
#
# Build mesa on the CachyOS znver3 host with rusticl re-enabled and
# generic-x86_64 codegen.  CFLAGS / CXXFLAGS drop -march=btver1 in
# favor of -march=x86-64 -mtune=generic so the resulting C/C++ .so
# is microarch-portable from Bobcat through Zen4.  RUSTFLAGS pin a
# musl rust target so the rust crates statically link musl libc
# instead of the build host's glibc, eliminating the GLIBC_2.*
# version skew between CachyOS (newer) and x130e Mint xanmod
# (older) for the rust-built rusticl runtime.
#
# Required toolchain on the build host:
#
#   - rustc with the x86_64-unknown-linux-musl target installed:
#       rustup target add x86_64-unknown-linux-musl
#       (or via rust-musl from the system package manager)
#   - clang / clang++ 21 (existing canonical compiler family per
#     feedback_distcc_fabric_clang21_btver1)
#   - bindgen 0.71+ with the drift fix landed
#     (see steinmarder docs/workspace/rusticl-bindgen-drift.md)
#
# Pump and distcc are intentionally OFF on this profile:
#   - 12 znver3 cores already saturate the build locally
#   - cross-microarch distribution would require every distcc
#     remote to have a matching musl-rust toolchain
#
# Note: the host driver and probes still build with the local
# build-host CFLAGS; only the mesa .so itself uses these flags.

set -a

# C / C++ compile flags: generic x86_64 baseline, no microarch tuning.
export CFLAGS="--target=x86_64-linux-gnu -O2 -march=x86-64 -mtune=generic -ffunction-sections -fdata-sections -fno-unroll-loops -fmerge-all-constants -pipe"
export CXXFLAGS="$CFLAGS"
export LDFLAGS="-Wl,--gc-sections"

# Rust flags: pin musl target so rust crates statically link musl.
# +crt-static would force-static the libc the crate already links;
# --target switches the entire target triple.  We want the latter
# for true musl independence.
export RUSTFLAGS="--target=x86_64-unknown-linux-musl -C target-cpu=x86-64 -C link-arg=-Wl,--gc-sections"

# Disable distcc + pump on this profile.  Single-host build.
unset DISTCC_HOSTS
unset DISTCC_PUMP
unset INCLUDE_SERVER_PORT
unset INCLUDE_SERVER_ARGS
unset INCLUDE_SERVER_PID
unset CCACHE_PREFIX

# Keep ccache for warm rebuilds on the same host.
export CCACHE_DIR="${CCACHE_DIR:-$HOME/.cache/ccache-cachyos-cross-rusticl-musl}"
mkdir -p "$CCACHE_DIR"

# sccache for rust crates (same pattern as other env files).
export SCCACHE_DIR="${SCCACHE_DIR:-$HOME/.cache/sccache-cachyos-cross-rusticl-musl}"
mkdir -p "$SCCACHE_DIR"
export RUSTC_WRAPPER="${RUSTC_WRAPPER:-sccache}"

set +a

echo "[env] cachyos-cross-rusticl-musl-x86-64-baseline loaded" >&2
echo "[env]   CC target: $(echo "$CFLAGS" | sed -n 's/.*--target=\([^ ]*\).*/\1/p')" >&2
echo "[env]   rust target: x86_64-unknown-linux-musl" >&2
echo "[env]   CCACHE_DIR=$CCACHE_DIR" >&2
echo "[env]   SCCACHE_DIR=$SCCACHE_DIR" >&2
