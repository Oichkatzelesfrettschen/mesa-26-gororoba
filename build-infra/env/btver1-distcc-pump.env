# btver1-distcc-pump.env -- x130e clean-build pump lane.
#
# Canonical split:
#   - warm incremental C/C++: ccache -> distcc -> clang, no pump
#   - cold clean C/C++:       distcc-pump -> distcc -> clang, no ccache
#   - Rust:                   sccache -> rustc
#
# Keep persistent ~/.distcc/hosts mDNS-only and no-pump-safe.  This env
# derives the pump-only host list in the shell by adding ,cpp to verified
# remote entries while preserving options such as ,lzo.
#
# DESKTOP-* / WSL in the pump lane: RESOLVED -- DESKTOP-CKP9KB6 has
# successfully built mesa + dEQP-VK in pump mode against btver1.
# Earlier Gallivm pump discrepancies are no longer reproducible at
# the current LLVM 22 + clang-21 toolchain pinning.
#
# Caveat: 1-5 translation units per cold full build may fail the pump
# preprocessor heuristic on DESKTOP-* (typically Gallivm or heavily
# template-instantiating Mesa C++ TUs whose include-fingerprint hash
# is not stable across the LAN crossing).  distcc-pump then falls
# back through the standard distcc ladder:
#   1. pump-mode preprocess on x130e + remote compile
#   2. classic distcc (no pump): full preprocess on x130e + remote compile
#   3. fully local compile on x130e (Bobcat)
# Step 3 is the safety net: 1-5 stray TUs build locally on Bobcat
# without breaking the rest of the build.  Local fallback for a
# handful of TUs costs seconds, not hours, so it is acceptable.
#
# Opt-out (return to no-pump mesh for the DESKTOP-* host only):
#
#     export TERAKAN_PUMP_ALLOW_DESKTOP=0
#
# Opt-in is now the default; the env block below treats absent
# or =1 as include, =0 as exclude.

unset CCACHE_PREFIX
unset CCACHE_PATH

export CFLAGS="-march=btver1 -mtune=btver1 -pipe -fno-emulated-tls"
export CXXFLAGS="$CFLAGS"
export LDFLAGS=""

export DISTCC_HOSTS="$(
    if [ -r "$HOME/.distcc/hosts" ]; then
        awk '{
            for (host_index = 1; host_index <= NF; host_index++) {
                host = $host_index
                if (host ~ /^DESKTOP-/ && ENVIRON["TERAKAN_PUMP_ALLOW_DESKTOP"] == "0") {
                    # DESKTOP-* explicitly opted out for this build.
                    # Default (unset or =1) keeps DESKTOP-* in the
                    # pump mesh; 1-5 TUs may fall back to local
                    # Bobcat compile, which the distcc-pump safety
                    # ladder handles transparently.
                    continue
                }
                if (host ~ /^\+/) {
                    continue
                }
                if (host !~ /^--/ && host !~ /^localhost/ && host !~ /(^|,)cpp(,|$)/) {
                    comma = index(host, ",")
                    if (comma) {
                        host = substr(host, 1, comma - 1) ",cpp" substr(host, comma)
                    } else {
                        host = host ",cpp"
                    }
                }
                printf "%s%s", seen ? " " : "", host
                seen++
            }
        }
        END { if (seen) printf "\n" }' "$HOME/.distcc/hosts"
    fi
)"

export SCCACHE_DIR="$HOME/.cache/sccache"
