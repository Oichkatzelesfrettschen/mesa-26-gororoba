# btver1-distcc-pump.env -- x130e clean-build pump lane.
#
# Canonical split:
#   - warm incremental C/C++: ccache -> distcc -> clang, no pump
#   - cold clean C/C++:       distcc-pump -> distcc -> clang, no ccache
#   - Rust:                   sccache -> rustc
#
# Keep persistent ~/.distcc/hosts mDNS-only and no-pump-safe.  This env
# derives the pump-only host list in the shell by adding ,cpp to verified
# remote entries while preserving options such as ,lzo.
#
# DESKTOP-* / WSL host class in the pump lane: default ON.
#
# distcc-pump's three-step include-fingerprint safety ladder handles
# the residual class of translation units whose preprocessed hash is
# not stable across a LAN crossing.  Per the distcc-pump manual:
#
#   1. pump preprocess on the client + remote compile
#   2. classic distcc preprocess on the client + remote compile
#   3. fully local compile on the client
#
# Step 3 is the safety net.  Typical C++ translation units that
# instantiate heavy templates or use generator-derived headers fall
# back to step 3 silently; the rest of the build dispatches through
# step 1 at full mesh speed.
#
# DESKTOP-* / WSL participation is the policy default below.
# Operators opt out per-build by exporting TERAKAN_PUMP_ALLOW_DESKTOP=0
# before sourcing this env.  Absent or =1 keeps DESKTOP-* in the
# pump lane.

unset CCACHE_PREFIX
unset CCACHE_PATH

export CFLAGS="-march=btver1 -mtune=btver1 -pipe -fno-emulated-tls"
export CXXFLAGS="$CFLAGS"
export LDFLAGS=""

export DISTCC_HOSTS="$(
    if [ -r "$HOME/.distcc/hosts" ]; then
        awk '{
            for (host_index = 1; host_index <= NF; host_index++) {
                host = $host_index
                if (host ~ /^DESKTOP-/ && ENVIRON["TERAKAN_PUMP_ALLOW_DESKTOP"] == "0") {
                    # DESKTOP-* explicitly opted out for this build.
                    # Default (unset or =1) keeps DESKTOP-* in the
                    # pump mesh; 1-5 TUs may fall back to local
                    # Bobcat compile, which the distcc-pump safety
                    # ladder handles transparently.
                    continue
                }
                if (host ~ /^\+/) {
                    continue
                }
                if (host !~ /^--/ && host !~ /^localhost/ && host !~ /(^|,)cpp(,|$)/) {
                    comma = index(host, ",")
                    if (comma) {
                        host = substr(host, 1, comma - 1) ",cpp" substr(host, comma)
                    } else {
                        host = host ",cpp"
                    }
                }
                printf "%s%s", seen ? " " : "", host
                seen++
            }
        }
        END { if (seen) printf "\n" }' "$HOME/.distcc/hosts"
    fi
)"

export SCCACHE_DIR="$HOME/.cache/sccache"
