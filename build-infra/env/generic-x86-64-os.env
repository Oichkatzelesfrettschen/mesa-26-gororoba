# generic-x86-64-os.env -- unified portable ccache+distcc lane for every machine.
#
# One generic-x86-64 target (default -Os, carried by the paired config's
# optimization option) that runs on the whole build fabric (x130e Bobcat, x570
# Zen, Vostro k8, ALIENWARE) instead of a per-host -march matrix.
# Source this from a shell or via `make build PROFILE=... HOSTENV=generic-x86-64-os`.
#
# distcc-pump is dead (removed upstream, incompatible with ccache).  This lane is
# the canonical ccache-first ordering: CCACHE_PREFIX=distcc inserts distcc
# BETWEEN ccache and the compiler on a cache miss, so ccache caches the local
# preprocessed compile and distcc only distributes misses.  The anti-pattern
# `ccache distcc clang` (ccache wrapping distcc) is not used.

# No pump: keep the include-server variables out of the environment.
unset DISTCC_PUMP
unset INCLUDE_SERVER_PORT
unset INCLUDE_SERVER_ARGS
unset INCLUDE_SERVER_PID
export CCACHE_PREFIX="${CCACHE_PREFIX:-distcc}"

# Pin a valid ccache size: a non-interactive shell can inherit CCACHE_MAXSIZE=""
# (empty), which ccache rejects with "invalid size" and aborts every compile.
# The :- form covers both unset and empty.
export CCACHE_MAXSIZE="${CCACHE_MAXSIZE:-20G}"
export CCACHE_DIR="$HOME/.cache/ccache"
export SCCACHE_DIR="$HOME/.cache/sccache"

# Hash the compiler by its --version string, not its mtime.  Under
# CCACHE_PREFIX=distcc the compiler ccache sees is the real clang, but pinning
# the version-string check keeps cache hits stable across distcc redeploys (an
# mtime-based check would treat every redeploy as a new compiler and reject the
# whole cache).  CCACHE_DEPEND uses depfiles for a better incremental hit rate.
export CCACHE_COMPILERCHECK="${CCACHE_COMPILERCHECK:-%compiler% --version}"
export CCACHE_DEPEND="${CCACHE_DEPEND:-true}"

# Portable target: base x86-64 (SSE2 baseline -- runs on k8 through Zen) tuned
# generic.  The OPTIMIZATION LEVEL is NOT set here: it is owned by the paired
# meson config's `optimization` option (gororoba-terakan.meson uses 's' -> -Os),
# so MODE=stable's `-Doptimization=2` on the meson command line takes effect.
# A hardcoded `-Os` in CFLAGS would be appended after meson's `-O2` and, since
# the last `-O` wins, would silently revert a MODE=stable build back to -Os.
# These flags are orthogonal to the level: drop semantic-interposition barriers,
# omit the frame pointer, pipe stages.  -fno-emulated-tls is REQUIRED on the
# clang Linux lane or libglapi.a fails to link (bare ELF-TLS symbols vs the
# __emutls_v.* the rest of the tree emits).
COMMON_FLAGS="-march=x86-64 -mtune=generic -pipe -fno-emulated-tls -fno-semantic-interposition -fomit-frame-pointer"
export CFLAGS="$COMMON_FLAGS"
export CXXFLAGS="$COMMON_FLAGS"

# Linker: prefer mold (fastest in 2026), then lld, then the toolchain default.
# Linking is client-local -- distcc distributes compiles, not links -- so the
# linker resolves on the build host and need not exist on remote workers.
if command -v mold >/dev/null 2>&1; then
    export LDFLAGS="-fuse-ld=mold"
elif command -v ld.lld >/dev/null 2>&1; then
    export LDFLAGS="-fuse-ld=lld"
else
    export LDFLAGS=""
fi

# distcc host list lives in ~/.distcc/hosts.  Flatten the multi-line file into a
# single space-separated string, skipping comment (#...) and blank lines (a
# leading-# flattened into the value makes distcc parse the whole thing as a
# comment and fall back to a local build) and stripping the pump-only ,cpp flag.
export DISTCC_HOSTS="$(
    if [ -r "$HOME/.distcc/hosts" ]; then
        awk '
        /^[[:space:]]*#/ { next }
        /^[[:space:]]*$/ { next }
        {
            for (host_index = 1; host_index <= NF; host_index++) {
                gsub(/,cpp/, "", $host_index)
                printf "%s%s", seen ? " " : "", $host_index
                seen++
            }
        }
        END { if (seen) printf "\n" }' "$HOME/.distcc/hosts"
    fi
)"
