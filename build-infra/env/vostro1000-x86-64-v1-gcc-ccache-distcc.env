# Vostro 1000 x86-64-v1 GCC ccache-first distcc environment.
#
# The GCC sibling of vostro1000-x86-64-v1-clang22-ccache-distcc: same host, same
# ccache-then-distcc chain, same six-job compile budget, gcc instead of clang.
# Pair with COMPILER_FAMILY=gnu, which resolves gcc/g++ into the generated
# toolchain overlay and leaves Meson on GNU binutils.
#
# distcc ships preprocessed source, so the volunteer's gcc generates the object
# this host links.  Both ends run gcc 16 today; set GOROROBA_GCC_VERSION to pin a
# major when the two diverge, and the overlay generator then requires gcc-N and
# g++-N by name rather than accepting whatever `gcc` resolves to.

unset DISTCC_PUMP
unset INCLUDE_SERVER_PORT
unset INCLUDE_SERVER_ARGS
unset INCLUDE_SERVER_PID

# The toolchain overlay is the single source of truth for the compiler, so drop
# any CC/CXX the login shell exported before it can shadow the overlay.
export GOROROBA_GCC_VERSION="${GOROROBA_GCC_VERSION:-}"
unset CC CXX
export PATH="/usr/bin:$PATH"

# Linker: gcc plus GNU ld.  The clang lane selects LLD because clang defaults to
# ld for its large static-ASan links; gcc's own driver default is the linker its
# runtime and spec files are built against, so this lane leaves CC_LD unset and
# takes it.  Override with CC_LD=... when a build needs a different linker.

export CCACHE_PATH="${CCACHE_PATH:-/usr/bin}"
export CCACHE_PREFIX="${CCACHE_PREFIX:-distcc}"
export CCACHE_DIR="${CCACHE_DIR:-$HOME/.cache/ccache}"
export CCACHE_MAXSIZE="${CCACHE_MAXSIZE:-20G}"
# Hash the resolved compiler by its --version string, not its mtime/size, and
# skip the preprocessor on a hit.  The compiler identity is part of the ccache
# key, so this lane and the clang lane share one cache directory without
# colliding.
export CCACHE_COMPILERCHECK="${CCACHE_COMPILERCHECK:-%compiler% --version}"
export CCACHE_DEPEND="${CCACHE_DEPEND:-true}"

vostro1000_gcc_distcc_hosts() {
    if [ -r "$HOME/.distcc/hosts" ]; then
        awk '
        /^[[:space:]]*#/ { next }
        {
            sub(/[[:space:]]*#.*/, "")
        }
        /^[[:space:]]*$/ { next }
        {
            for (host_index = 1; host_index <= NF; host_index++) {
                host = $host_index
                gsub(/,cpp/, "", host)
                if (host ~ /^localhost(\/[0-9]+)?(,|$)/)
                    sub(/,.*/, "", host)
                if (host == "")
                    continue
                printf "%s%s", seen ? " " : "", host
                seen++
            }
        }
        END { if (seen) printf "\n" }' "$HOME/.distcc/hosts"
    fi
}

DISTCC_HOSTS="$(vostro1000_gcc_distcc_hosts)"
if [ -n "$DISTCC_HOSTS" ]; then
    case " $DISTCC_HOSTS " in
        *" localhost/"*) ;;
        *" localhost "*) ;;
        *) DISTCC_HOSTS="$DISTCC_HOSTS localhost/2" ;;
    esac
else
    DISTCC_HOSTS="localhost/2"
fi
export DISTCC_HOSTS
unset -f vostro1000_gcc_distcc_hosts

# The Vostro and its distcc volunteer share one six-job compile budget.  The
# host file assigns those slots between localhost and the volunteer; Ninja
# stays capped at six even when a host advertises more service capacity.
GOROROBA_DISTCC_JOBS=6
export GOROROBA_DISTCC_JOBS
export OMP_NUM_THREADS="${OMP_NUM_THREADS:-2}"
