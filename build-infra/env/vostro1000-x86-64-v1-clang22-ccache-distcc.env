# Vostro 1000 x86-64-v1 clang 22 ccache-first distcc environment.
#
# This is the canonical incremental RS482/r300vk lane when ALIENWARE is on the
# LAN.  ccache runs on the Vostro client and uses CCACHE_PREFIX=distcc on cache
# misses.  The distcc volunteers only need clang-22/clang++-22 and distccd; they
# do not need ccache.

unset DISTCC_PUMP
unset INCLUDE_SERVER_PORT
unset INCLUDE_SERVER_ARGS
unset INCLUDE_SERVER_PID

export MESA_LLVM_VERSION="${MESA_LLVM_VERSION:-22}"
export GOROROBA_LLVM_VERSION="${GOROROBA_LLVM_VERSION:-22}"
export PATH="/usr/bin:/usr/local/bin:$PATH"

export CCACHE_PATH="${CCACHE_PATH:-/usr/bin:/usr/local/bin}"
export CCACHE_PREFIX="${CCACHE_PREFIX:-distcc}"
export CCACHE_DIR="${CCACHE_DIR:-$HOME/.cache/ccache}"
export CCACHE_MAXSIZE="${CCACHE_MAXSIZE:-20G}"
# Hash the compiler by its --version string, not its mtime/size.  With
# CCACHE_PREFIX=distcc the compiler ccache sees is the distcc wrapper, whose
# mtime changes across rebuilds; the default compilercheck would then treat
# every build as a new compiler and miss the cache.  Depend mode skips the
# preprocessor on a hit, which is the faster path for the warm incremental lane.
export CCACHE_COMPILERCHECK="${CCACHE_COMPILERCHECK:-%compiler% --version}"
export CCACHE_DEPEND="${CCACHE_DEPEND:-true}"

vostro1000_clang22_distcc_tcp_ok() {
    host="$1"
    getent hosts "$host" >/dev/null 2>&1 &&
        timeout 2 bash -c ":</dev/tcp/$host/3632" >/dev/null 2>&1
}

vostro1000_clang22_distcc_first_tcp_host() {
    for host in "$@"; do
        if vostro1000_clang22_distcc_tcp_ok "$host"; then
            printf '%s' "$host"
            return 0
        fi
    done
    return 1
}

vostro1000_clang22_distcc_hosts() {
    hosts=""
    alienware_host="$(vostro1000_clang22_distcc_first_tcp_host "ALIENWARE.local" "ALIENWARE" || true)"
    x570_host="$(vostro1000_clang22_distcc_first_tcp_host "x570-5600X3D" "x570-5600X3D.local" || true)"

    if [ -n "$alienware_host" ]; then
        hosts="${hosts:+$hosts }$alienware_host/32,lzo"
    fi

    if [ -n "$x570_host" ]; then
        hosts="${hosts:+$hosts }$x570_host/16,lzo"
    fi

    if [ -n "$hosts" ]; then
        printf '%s' "--randomize $hosts localhost/2,lzo"
    else
        printf '%s' "localhost/2,lzo"
    fi
}

DISTCC_HOSTS="$(vostro1000_clang22_distcc_hosts)"
export DISTCC_HOSTS
unset -f vostro1000_clang22_distcc_tcp_ok
unset -f vostro1000_clang22_distcc_first_tcp_host
unset -f vostro1000_clang22_distcc_hosts

# Build parallelism follows the live distcc pool, not the 2-core Turion: sum the
# per-host slot counts (the /N in each DISTCC_HOSTS entry, e.g. ALIENWARE/32 +
# x570/16 + localhost/2 = 50).  The Makefile ninja recipes prefer
# GOROROBA_DISTCC_JOBS over the static per-host JOBS, so -j tracks how many
# compile jobs the mesh can actually run in parallel; when every volunteer is
# down it collapses to the localhost slot count.
GOROROBA_DISTCC_JOBS="$(printf '%s\n' "$DISTCC_HOSTS" | grep -oE '/[0-9]+' | tr -d / | awk '{sum += $1} END {print (sum > 0) ? sum : 16}')"
export GOROROBA_DISTCC_JOBS
export MAKEFLAGS="${MAKEFLAGS:--j${GOROROBA_DISTCC_JOBS}}"
export OMP_NUM_THREADS="${OMP_NUM_THREADS:-2}"
