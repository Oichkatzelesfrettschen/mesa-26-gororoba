# Vostro 1000 x86-64-v1 clang 22 ccache-first distcc environment.
#
# This is the canonical incremental RS482/r300vk lane when ALIENWARE is on the
# LAN.  ccache runs on the Vostro client and uses CCACHE_PREFIX=distcc on cache
# misses.  The distcc volunteers only need clang-22/clang++-22 and distccd; they
# do not need ccache.

unset DISTCC_PUMP
unset INCLUDE_SERVER_PORT
unset INCLUDE_SERVER_ARGS
unset INCLUDE_SERVER_PID

export MESA_LLVM_VERSION="${MESA_LLVM_VERSION:-22}"
export GOROROBA_LLVM_VERSION="${GOROROBA_LLVM_VERSION:-22}"

export CCACHE_PREFIX="${CCACHE_PREFIX:-distcc}"
export CCACHE_DIR="${CCACHE_DIR:-$HOME/.cache/ccache}"
export CCACHE_MAXSIZE="${CCACHE_MAXSIZE:-20G}"

vostro1000_clang22_distcc_tcp_ok() {
    host="$1"
    getent hosts "$host" >/dev/null 2>&1 &&
        timeout 2 bash -c ":</dev/tcp/$host/3632" >/dev/null 2>&1
}

vostro1000_clang22_distcc_hosts() {
    hosts=""

    if vostro1000_clang22_distcc_tcp_ok "ALIENWARE.local"; then
        hosts="${hosts:+$hosts }ALIENWARE.local/32,lzo"
    fi

    if vostro1000_clang22_distcc_tcp_ok "x570-5600X3D.local"; then
        hosts="${hosts:+$hosts }x570-5600X3D.local/16,lzo"
    fi

    if [ -n "$hosts" ]; then
        printf '%s' "--randomize $hosts localhost/2,lzo"
    else
        printf '%s' "localhost/2,lzo"
    fi
}

DISTCC_HOSTS="$(vostro1000_clang22_distcc_hosts)"
export DISTCC_HOSTS
unset -f vostro1000_clang22_distcc_tcp_ok
unset -f vostro1000_clang22_distcc_hosts

export MAKEFLAGS="${MAKEFLAGS:--j36}"
export OMP_NUM_THREADS="${OMP_NUM_THREADS:-2}"
