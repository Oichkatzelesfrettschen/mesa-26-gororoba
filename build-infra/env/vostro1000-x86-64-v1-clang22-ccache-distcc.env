# Vostro 1000 x86-64-v1 clang ccache-first distcc environment.
#
# This is the canonical incremental RS482/r3v lane.  ccache runs on the
# Vostro client and uses CCACHE_PREFIX=distcc on cache misses.  The default
# ccache lane sends distcc the compiler path resolved on the client; use
# COMPILER_CHAIN=distcc when volunteers must resolve the clang major through PATH.

unset DISTCC_PUMP
unset INCLUDE_SERVER_PORT
unset INCLUDE_SERVER_ARGS
unset INCLUDE_SERVER_PID

# Compiler selection: use the DETECTED system clang.  The Makefile toolchain
# overlay generator probes clang-22, clang-21, ... and picks the highest
# installed major when no version is requested, and writes it into the generated
# [binaries] overlay -- so the overlay is the single source of truth.  This lane
# expects clang 22 but no longer hard-forces it; set MESA_LLVM_VERSION=N to pin a
# specific major when a build needs one.  Drop any CC/CXX inherited from the login
# shell so a stale value (e.g. an older clang) can never shadow the detected
# overlay toolchain meson actually uses.
export MESA_LLVM_VERSION="${MESA_LLVM_VERSION:-}"
unset CC CXX
export PATH="/usr/bin:$PATH"

# Linker: clang + LLD.  Not setting CC_LD leaves clang defaulting to GNU /usr/bin/ld,
# which is far slower for the large -O0 + static-ASan links this lane produces (the
# build-tests executables --whole-archive the libclang_rt.asan*.a runtime, and the
# instrumented libgallium.so is huge).  LLD is the standardized, compliant choice;
# mold is a faster alternative but is not used here.  Override with CC_LD=... if a
# specific build needs a different linker.
export CC_LD="${CC_LD:-lld}"
export CXX_LD="${CXX_LD:-lld}"

export CCACHE_PATH="${CCACHE_PATH:-/usr/bin}"
export CCACHE_PREFIX="${CCACHE_PREFIX:-distcc}"
export CCACHE_DIR="${CCACHE_DIR:-$HOME/.cache/ccache}"
export CCACHE_MAXSIZE="${CCACHE_MAXSIZE:-20G}"
# Hash the resolved compiler by its --version string, not its mtime/size.
# Compiler package rebuilds can move the binary timestamp without changing the
# Clang major used by this lane.  Depend mode skips the preprocessor on a hit,
# which is the faster path for the warm incremental lane.
export CCACHE_COMPILERCHECK="${CCACHE_COMPILERCHECK:-%compiler% --version}"
export CCACHE_DEPEND="${CCACHE_DEPEND:-true}"

vostro1000_clang22_distcc_hosts() {
    if [ -r "$HOME/.distcc/hosts" ]; then
        awk '
        /^[[:space:]]*#/ { next }
        {
            sub(/[[:space:]]*#.*/, "")
        }
        /^[[:space:]]*$/ { next }
        {
            for (host_index = 1; host_index <= NF; host_index++) {
                host = $host_index
                gsub(/,cpp/, "", host)
                if (host ~ /^localhost(\/[0-9]+)?(,|$)/)
                    sub(/,.*/, "", host)
                if (host == "")
                    continue
                printf "%s%s", seen ? " " : "", host
                seen++
            }
        }
        END { if (seen) printf "\n" }' "$HOME/.distcc/hosts"
    fi
}

DISTCC_HOSTS="$(vostro1000_clang22_distcc_hosts)"
if [ -n "$DISTCC_HOSTS" ]; then
    case " $DISTCC_HOSTS " in
        *" localhost/"*) ;;
        *" localhost "*) ;;
        *) DISTCC_HOSTS="$DISTCC_HOSTS localhost/2" ;;
    esac
else
    DISTCC_HOSTS="localhost/2"
fi
export DISTCC_HOSTS
unset -f vostro1000_clang22_distcc_hosts

# The Vostro and its distcc volunteer share one six-job compile budget.  The
# host file assigns those slots between localhost and the volunteer; Ninja
# stays capped at six even when a host advertises more service capacity.
MESA_DISTCC_JOBS=6
export MESA_DISTCC_JOBS
export OMP_NUM_THREADS="${OMP_NUM_THREADS:-2}"
