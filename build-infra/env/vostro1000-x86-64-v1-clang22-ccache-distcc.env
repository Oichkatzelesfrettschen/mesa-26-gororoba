# Vostro 1000 x86-64-v1 clang 22 ccache-first distcc environment.
#
# This is the canonical incremental RS482/r300vk lane.  ccache runs on the
# Vostro client and uses CCACHE_PREFIX=distcc on cache misses.  The distcc
# volunteers only need clang-22/clang++-22 and distccd; they do not need ccache.

unset DISTCC_PUMP
unset INCLUDE_SERVER_PORT
unset INCLUDE_SERVER_ARGS
unset INCLUDE_SERVER_PID

export MESA_LLVM_VERSION="${MESA_LLVM_VERSION:-22}"
export GOROROBA_LLVM_VERSION="${GOROROBA_LLVM_VERSION:-22}"
export PATH="/usr/bin:$PATH"

export CCACHE_PATH="${CCACHE_PATH:-/usr/bin}"
export CCACHE_PREFIX="${CCACHE_PREFIX:-distcc}"
export CCACHE_DIR="${CCACHE_DIR:-$HOME/.cache/ccache}"
export CCACHE_MAXSIZE="${CCACHE_MAXSIZE:-20G}"
# Hash the compiler by its --version string, not its mtime/size.  With
# CCACHE_PREFIX=distcc the compiler ccache sees is the distcc wrapper, whose
# mtime changes across rebuilds; the default compilercheck would then treat
# every build as a new compiler and miss the cache.  Depend mode skips the
# preprocessor on a hit, which is the faster path for the warm incremental lane.
export CCACHE_COMPILERCHECK="${CCACHE_COMPILERCHECK:-%compiler% --version}"
export CCACHE_DEPEND="${CCACHE_DEPEND:-true}"

vostro1000_clang22_distcc_hosts() {
    if [ -r "$HOME/.distcc/hosts" ]; then
        awk '
        /^[[:space:]]*#/ { next }
        /^[[:space:]]*$/ { next }
        {
            for (host_index = 1; host_index <= NF; host_index++) {
                host = $host_index
                gsub(/,cpp/, "", host)
                if (host == "")
                    continue
                printf "%s%s", seen ? " " : "", host
                seen++
            }
        }
        END { if (seen) printf "\n" }' "$HOME/.distcc/hosts"
    fi
}

DISTCC_HOSTS="$(vostro1000_clang22_distcc_hosts)"
if [ -n "$DISTCC_HOSTS" ]; then
    case " $DISTCC_HOSTS " in
        *" localhost/"*) ;;
        *" localhost,"*) ;;
        *" localhost "*) ;;
        *) DISTCC_HOSTS="$DISTCC_HOSTS localhost/2,lzo" ;;
    esac
else
    DISTCC_HOSTS="localhost/2,lzo"
fi
export DISTCC_HOSTS
unset -f vostro1000_clang22_distcc_hosts

# Build parallelism follows the configured distcc pool, not the 2-core Turion:
# sum the per-host slot counts (the /N in each DISTCC_HOSTS entry).  The
# Makefile ninja recipes prefer GOROROBA_DISTCC_JOBS over the static per-host
# JOBS, so -j tracks how many compile jobs the mesh can run in parallel; when no
# remote volunteers are configured it collapses to the localhost slot count.
GOROROBA_DISTCC_JOBS="$(printf '%s\n' "$DISTCC_HOSTS" | grep -oE '/[0-9]+' | tr -d / | awk '{sum += $1} END {print (sum > 0) ? sum : 16}')"
export GOROROBA_DISTCC_JOBS
export MAKEFLAGS="${MAKEFLAGS:--j${GOROROBA_DISTCC_JOBS}}"
export OMP_NUM_THREADS="${OMP_NUM_THREADS:-2}"
