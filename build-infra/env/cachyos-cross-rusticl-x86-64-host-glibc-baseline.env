# cachyos-cross-rusticl-x86-64-host-glibc-baseline.env
#
# Companion env file for build-infra/configs/
#   terakan-cachyos-cross-rusticl-x86-64-host-glibc-baseline.meson
#
# Build mesa on the CachyOS znver3 host with rusticl re-enabled and
# generic-x86_64 codegen targeting the x130e Bobcat runtime via the
# local-build-then-rsync workflow.  The C / C++ side compiles at -Os
# for Bobcat's smaller cache topology (32 KiB L1I + 32 KiB L1D +
# 512 KiB L2 per core), which is the canonical optimisation level
# for the Bobcat target across this fabric.  -O3 was validated as
# build-clean during the bindgen-drift verification round but is
# NOT the shipping setting because -O3 generates larger code that
# thrashes Bobcat's small caches.
#
# Rust crates link against the host glibc.  Full musl-everywhere is
# not currently achievable: see the three-barrier RCA in
# ../../../steinmarder/docs/workspace/rusticl-bindgen-drift.md.  The
# pragmatic path for cross-host portability of the resulting .so is
# a container-build with a Debian Bookworm rootfs on cachyos
# (Bookworm glibc 2.36 is older than x130e xanmod 2.39 and any
# newer fabric host).
#
# Toolchain preconditions on the build host (verified 2026-05-21):
#
#   - bindgen >= 0.72 (cachyos 0.72.1 reifies pipe_screen +
#     pipe_image_view, replacing the opaque stubs that 0.71.1 emitted).
#   - LLVM 22 (export MESA_LLVM_VERSION=22 so Mesa's
#     _llvmspirvlib_version pin matches the installed
#     SPIRV-LLVM-Translator 22.x).  The Makefile's find_tool logic
#     (build-infra/Makefile around the find_tool clang block)
#     selects llvm-config-22 if present, otherwise the unsuffixed
#     /usr/bin/llvm-config (cachyos default = LLVM 22).
#   - libclc (sudo pacman -S libclc; required by with_clc =
#     with_gallium_rusticl).
#   - SPIR-V Tools >= 2024.1 (cachyos 1.4.350.0).
#   - rustc with the host gnu target (default; no rustup target add
#     needed since rust crates link against host glibc).
#
# Distcc + pump are intentionally OFF on this profile.  Distcc only
# distributes C / C++ compilation; the 12 znver3 cores on the build
# host saturate the C / C++ load locally, and adding remotes would
# require every distcc node to carry a matching C / C++ cross
# toolchain + sysroot.  Rust compilation always runs locally on the
# host regardless of distcc topology.

set -a

# C / C++ compile flags: generic x86_64 baseline at -Os for Bobcat
# cache topology.  See the file header for the -O3 trade-off rationale.
export CFLAGS="--target=x86_64-linux-gnu -Os -march=x86-64 -mtune=generic -ffunction-sections -fdata-sections -fno-unroll-loops -fmerge-all-constants -pipe"
export CXXFLAGS="$CFLAGS"
export LDFLAGS="-Wl,--gc-sections"

# Rust flags: generic x86_64 codegen + section-GC, no microarch tuning,
# no --target switch.  Attempting --target=x86_64-unknown-linux-musl
# globally breaks proc-macros (E0463 "can't find crate for
# rusticl_proc_macros" because rustc dlopens proc-macros from the host
# triple).  -C target-feature=+crt-static has the same proc-macro
# conflict.  See the RCA in
# ../../../steinmarder/docs/workspace/rusticl-bindgen-drift.md.
export RUSTFLAGS="-C target-cpu=x86-64 -C link-arg=-Wl,--gc-sections"

# Disable distcc + pump on this profile.  Single-host build.
unset DISTCC_HOSTS
unset DISTCC_PUMP
unset INCLUDE_SERVER_PORT
unset INCLUDE_SERVER_ARGS
unset INCLUDE_SERVER_PID
unset CCACHE_PREFIX

# Keep ccache for warm C / C++ rebuilds on the same host.  sccache is
# configured by build-infra/Makefile via the generated meson native
# file `rust = ['sccache', 'rustc']`; do NOT set RUSTC_WRAPPER here
# since meson's native-file binary specification overrides env vars.
export CCACHE_DIR="${CCACHE_DIR:-$HOME/.cache/ccache-cachyos-cross-rusticl-host-glibc}"
mkdir -p "$CCACHE_DIR"

set +a
