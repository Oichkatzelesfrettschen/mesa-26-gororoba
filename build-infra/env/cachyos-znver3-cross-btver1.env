# cachyos-znver3-cross-btver1.env -- CachyOS (Ryzen 5 5600X3D, znver3)
# build host targeting x130e (AMD E-300 Bobcat, btver1) runtime.
#
# Use this when building the Terakan/r600 .so on the CachyOS local box
# and installing it onto x130e via rsync + sudo cp.  The CachyOS host
# has 12 logical cores vs x130e's 2; building locally with -j12 + ccache
# is ~6-10x faster than building over SSH on x130e.
#
# CFLAGS target -march=btver1 to produce ABI/ISA-compatible code that
# runs on x130e's E-300 APU.  CachyOS znver3 host runs the resulting
# .so binaries fine too (btver1 is a subset of znver3 ISA), so the
# locally-installed mesa works for any local debugging.
#
# Companion meson profile: configs/terakan-cachyos-cross-btver1.meson
# Companion workflow doc: ../../../steinmarder/docs/workspace/local-build-cross-btver1.md
#
# Compiler chain: clang-22 is expected on PATH on CachyOS;
# ccache wraps the compile via meson's [binaries] block in the
# accompanying config.  No distcc -- 12 local cores beats a 2-core
# distcc worker over the LAN once you account for distcc network
# roundtrips on a slow Bobcat link.

# Target the slowest GPU host (x130e Bobcat) for ISA compatibility.
# The same flags used by x130e's btver1.env to keep code-gen aligned
# (no surprise instructions our test rig can't decode).
export MARCH_TARGET=btver1
export CFLAGS='-Os -march=btver1 -mtune=btver1 -ffunction-sections -fdata-sections -fno-unroll-loops -fmerge-all-constants -pipe'
export CXXFLAGS="$CFLAGS"
export LDFLAGS='-Wl,--gc-sections -fuse-ld=lld'

# CC/CXX env hints (most consumers find these via meson's [binaries]
# block in the .meson file; these are kept for non-meson callers that
# shell out to a configure-equivalent step).
export CC='ccache clang-22'
export CXX='ccache clang++'

# No distcc on this host -- znver3 12-thread build outpaces the 2-core
# Bobcat distcc worker.  If/when a second znver3 box joins the mesh,
# add distcc here.
# unset CCACHE_PREFIX
