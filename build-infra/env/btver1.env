# btver1.env -- x130e (AMD E-300 Bobcat) toolchain env.
#
# Source this from a shell (or via `make configure PROFILE=... HOSTENV=btver1`)
# before `meson setup`.  The /tmp/distcc-wrap/ wrappers resolve the
# compile chain:
#
#    CC = ccache -> distcc -> /usr/bin/clang-22
#
# ccache fronts distcc so cache hits skip the network roundtrip entirely;
# distcc fronts clang so misses parallelize across DESKTOP-CKP9KB6 + Mac.
# Regenerate the wrappers with `./scripts/setup-distcc.sh` after any
# reboot (`/tmp` is cleared).
#
# See ../../../steinmarder/docs/workspace/mesa-fork-synthesis.md.

# C / C++ compile chain: ccache -> distcc -> clang-22
export CC="/tmp/distcc-wrap/cc"
export CXX="/tmp/distcc-wrap/c++"

# Rust via sccache (ccache does not support rustc natively).  Cargo
# picks this up automatically at build time.
export RUSTC_WRAPPER="/usr/bin/sccache"

# Bobcat-specific tuning: -march=btver1 + -Os for link-time tightness on
# a 2-core 1.3 GHz host.  release profile overrides -Os with -O2 + LTO.
export CFLAGS="-march=btver1 -mtune=btver1 -pipe"
export CXXFLAGS="$CFLAGS"
export LDFLAGS=""

# distcc host list lives in ~/.distcc/hosts (persistent); slots total ~42.
# ninja -j$(JOBS) in the Makefile honours make jobserver.
export DISTCC_HOSTS="$(cat ~/.distcc/hosts 2>/dev/null | tr \"\\n\" \" \")"

# Ensure ccache/sccache stats are centralised so `ccache -s` / `sccache -s`
# across builds is comparable.
export CCACHE_DIR="$HOME/.cache/ccache"
export SCCACHE_DIR="$HOME/.cache/sccache"
