# btver1.env -- x130e (AMD E-300 Bobcat) toolchain env.
#
# Source this from a shell (or via `make configure PROFILE=... HOSTENV=btver1`)
# before `meson setup`.  Captures the clang-22 + distcc + Bobcat tuning
# derived from distcc-clang22.ini and the legacy build-terakan-distcc
# configure logs.
#
# See ../../../steinmarder/docs/workspace/mesa-fork-synthesis.md.

# Compiler wrappers live in /tmp (recreated after reboot via
# scripts/setup-distcc.sh -- add later).
export CC="/tmp/distcc-wrap/cc"
export CXX="/tmp/distcc-wrap/c++"

# Bobcat-specific tuning: -march=btver1 + -Os for link-time tightness on
# a 2-core 1.3 GHz host.  release profile overrides -Os with -O2 + LTO.
export CFLAGS="-march=btver1 -mtune=btver1 -pipe"
export CXXFLAGS="$CFLAGS"
export LDFLAGS=""

# distcc host list lives in ~/.distcc/hosts (persistent); slots total ~42.
# ninja -j$(JOBS) in the Makefile honours make jobserver.
export DISTCC_HOSTS="$(cat ~/.distcc/hosts 2>/dev/null | tr '\n' ' ')"

# ccache in front of distcc for linkless rebuilds.
export CCACHE_PREFIX="distcc"
