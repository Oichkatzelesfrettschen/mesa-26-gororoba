# btver1-distcc-ccache-warm.env -- x130e warm-incremental lane.
#
# Companion to btver1-distcc-pump.env.  Per the canonical split:
#
#   - warm incremental C/C++: ccache -> distcc -> clang, no pump
#       (this file)
#   - cold clean C/C++:       distcc-pump -> distcc -> clang, no ccache
#       (btver1-distcc-pump.env)
#   - Rust:                   sccache -> rustc
#
# When to source which file:
#
#   - First time building a target after a wipe / fresh checkout:
#     btver1-distcc-pump.env.  Cache hit rate is 0%; pump amortizes
#     preprocessing across the mesh; ccache would add wrapper
#     overhead with no payoff and would trip the pump-mode
#     discrepancy counter on the first cross-LAN preprocessor
#     mismatch -> demotion to plain distcc.
#
#   - Subsequent rebuilds where most TUs should hit cache:
#     btver1-distcc-ccache-warm.env (this file).  ccache hashes the
#     preprocessed source locally; on miss invokes `distcc clang` to
#     ship the preprocessed source to a remote.  Pump's
#     include-server is NOT in play here -- the cold-clean pass that
#     populated ccache already did the heavy preprocessing once.
#
# Why ccache + distcc-pump together does not work:
#
#   - ccache wants to preprocess locally and hash the output.
#   - distcc-pump wants to preprocess once via its include-server
#     and ship preprocessed source to remote.
#   - Their preprocessed byte streams differ (line markers,
#     working-directory absolute paths, time-sensitive macros).
#     The pump discrepancy counter trips on the first divergence;
#     default DISTCC_MAX_DISCREPANCY=1 then demotes the entire run
#     to plain distcc.
#
#   This is the practitioner consensus (ccache/ccache#320, Gentoo
#   wiki Distcc page, distcc upstream pump.in commentary, zaleos
#   ccache+distcc benchmark).
#
# Per-environment knobs:
#
#   - CCACHE_BASEDIR.  Set to the repo root so absolute paths in
#     compile commands hash to a stable form.  Without this, ccache
#     misses on every TU whose path differs across checkout
#     locations.
#
#   - CCACHE_COMPILERCHECK.  Use the `%compiler% --version` form so
#     ccache hashes the clang version string instead of distcc's
#     mtime (distcc is the literal binary ccache sees as
#     "compiler" via CCACHE_PREFIX).
#
#   - CCACHE_DEPEND (ccache 4+).  Use depfile-mode hashing instead
#     of the preprocessor-output mode.  Faster + better hit rate on
#     incremental rebuilds.
#
#   - CCACHE_PREFIX=distcc.  Chain: ccache hashes locally, on miss
#     prefixes the compiler with distcc which goes to a remote.

unset INCLUDE_SERVER_PORT
unset PUMP_SOCKDIR

export CFLAGS="-march=btver1 -mtune=btver1 -pipe -fno-emulated-tls"
export CXXFLAGS="$CFLAGS"
export LDFLAGS=""

export CCACHE_PREFIX="distcc"
export CCACHE_COMPILERCHECK="%compiler% --version 2>&1 | head -n1"
export CCACHE_DEPEND=true
# CCACHE_BASEDIR is set per-build by the runner; the env intentionally
# does not pin it because different build trees want different roots.

# DISTCC_HOSTS for the warm lane: same explicit-list shape as the
# pump-lane env's awk derivation, but WITHOUT the ,cpp pump flag.
# Mac stays out of the explicit list (per operator decision); other
# operators can append manually.
export DISTCC_HOSTS="$(
    if [ -r "$HOME/.distcc/hosts" ]; then
        awk '
        # Skip comment (#...) and blank lines: a leading-# line flattened into
        # the single-line DISTCC_HOSTS comments out the real hosts, and distcc
        # then reports "contained no hosts" and falls back to a local build.
        /^[[:space:]]*#/ { next }
        /^[[:space:]]*$/ { next }
        {
            for (host_index = 1; host_index <= NF; host_index++) {
                host = $host_index
                if (host ~ /^ALIENWARE-/ && ENVIRON["TERAKAN_WARM_ALLOW_ALIENWARE"] == "0") {
                    continue
                }
                if (host ~ /^\+/) {
                    # Drop zeroconf so Mac is not auto-discovered.
                    continue
                }
                printf "%s%s", seen ? " " : "", host
                seen++
            }
        }
        END { if (seen) printf "\n" }' "$HOME/.distcc/hosts"
    fi
)"

export SCCACHE_DIR="$HOME/.cache/sccache"
