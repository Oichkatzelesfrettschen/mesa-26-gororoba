# btver1-ccache-no-pump.env -- x130e ccache-first distcc without pump.
#
# Source this from a shell (or via `make configure PROFILE=... HOSTENV=btver1`)
# before `meson setup`.
#
# Compiler chain is specified in each build-infra/configs/*.meson native
# file via [binaries]:
#
#     c   = ['ccache', 'clang-21']
#     cpp = ['ccache', 'clang++-21']
#     rust = ['sccache', 'rustc']
#
# With CCACHE_PREFIX=distcc (below), ccache inserts distcc BETWEEN itself
# and the compiler on cache miss.  This is the canonical ccache+distcc
# ordering per https://ccache.dev/manual/latest.html -- the ANTI-PATTERN
# `ccache distcc clang-21` (ccache wrapping distcc) is explicitly
# deprecated because ccache hashes distcc's mtime as the compiler and
# refuses to share cache between with- and without-distcc builds.
#
# See ../../../steinmarder/docs/workspace/ccache-sccache-wiring.md
# for the full RCA.

# ccache prepends distcc onto the actual compiler on miss.  This profile is
# explicitly not a distcc-pump lane: invoke plain make/ninja, and keep pump
# variables out of the environment so generated-header consistency behavior is
# the normal ccache+distcc path.
unset DISTCC_PUMP
unset INCLUDE_SERVER_PORT
unset INCLUDE_SERVER_ARGS
unset INCLUDE_SERVER_PID
export CCACHE_PREFIX="${CCACHE_PREFIX:-distcc}"

# TLS model: without -fno-emulated-tls, clang-21 emits __emutls_v.*
# symbols for libglapi.a while glthread.c/texobj.c reference the
# bare ELF-TLS symbol, causing an undefined-reference link failure
# at 1293/1414.  Upstream Mesa only force-disables emutls for
# Android; clang-21 on Linux/btver1 needs it too.
export CFLAGS="-march=btver1 -mtune=btver1 -pipe -fno-emulated-tls"
export CXXFLAGS="$CFLAGS"
export LDFLAGS=""

# distcc host list lives in ~/.distcc/hosts (persistent); slots total ~42.
# Flatten the multi-line file into a single space-separated string, but strip
# the distcc-pump-only `,cpp` host option so plain distcc never asks for the
# include server.  Preserve other options such as `,lzo`.
export DISTCC_HOSTS="$(
    if [ -r "$HOME/.distcc/hosts" ]; then
        awk '{
            for (host_index = 1; host_index <= NF; host_index++) {
                gsub(/,cpp/, "", $host_index)
                printf "%s%s", seen ? " " : "", $host_index
                seen++
            }
        }
        END { if (seen) printf "\n" }' "$HOME/.distcc/hosts"
    fi
)"

# Centralise ccache/sccache stats so `ccache -s` / `sccache -s` across
# builds is comparable and the caches survive build-tree wipes.
export CCACHE_DIR="$HOME/.cache/ccache"
export SCCACHE_DIR="$HOME/.cache/sccache"
