# cachyos-znver3-cross-btver1.env -- CachyOS (Ryzen 5 5600X3D, znver3)
# build host targeting x130e (AMD E-300 Bobcat, btver1) runtime.
#
# Use this when building the Terakan/r600 .so on the CachyOS local box
# and installing it onto x130e via rsync + sudo cp.  The CachyOS host
# has 12 logical cores vs x130e's 2; building locally with -j12 + ccache
# is ~6-10x faster than building over SSH on x130e.
#
# Code generation is governed by the companion profile 5_, which pins
# -march=x86-64 -mtune=generic -O2 in its c_args.  That x86-64 baseline is a
# strict subset of the x130e E-300's btver1 ISA, so the .so binaries run on
# x130e (and on the CachyOS znver3 host for local debugging).  This env does NOT
# set -march, because the profile's c_args override the environment CFLAGS; see
# the CFLAGS note below.
#
# Companion meson profile: configs/alternates/5_terakan_norusticl_release_x86_64v1-clang22-distcc-cache.meson
# Companion workflow doc: ../../../steinmarder/docs/workspace/local-build-cross-btver1.md
#
# Compiler chain: build-infra/Makefile writes the Meson native overlay
# from the coherent LLVM family installed on PATH.  No distcc -- 12 local
# cores beat a 2-core Bobcat distcc worker over the LAN once you account
# for distcc network roundtrips on a slow Bobcat link.

# Do NOT set -march/-mtune/-O here.  The companion profile 5_ pins
# c_args/cpp_args with -march=x86-64 -mtune=generic -O2, and Meson applies the
# native-file c_args after the environment CFLAGS, so any -march/-O set here is
# overridden -- setting -march=btver1 would silently lose to -march=x86-64 and
# only confuse a reader.  The x86-64 baseline the profile pins is a strict subset
# of btver1's ISA, so it runs correctly on the x130e E-300; the profile also sets
# display-info='disabled' so a CachyOS-built binary loads against x130e's
# libdisplay-info.so.2.  Keep only the size/link flags, which are additive and do
# not conflict with the profile.
export CFLAGS='-ffunction-sections -fdata-sections -fno-unroll-loops -fmerge-all-constants -pipe'
export CXXFLAGS="$CFLAGS"
export LDFLAGS='-Wl,--gc-sections -fuse-ld=lld'

# No distcc on this host -- znver3 12-thread build outpaces the 2-core
# Bobcat distcc worker.  If/when a second znver3 box joins the mesh,
# add distcc here.
# unset CCACHE_PREFIX
