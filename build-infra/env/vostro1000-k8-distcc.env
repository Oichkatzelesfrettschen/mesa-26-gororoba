# Vostro 1000 k8 direct-distcc environment (no ccache intermediary).
#
# Use for the r300-vostro-k8-release and r300-vostro-k8-debug canonical builds.
# No ccache prefix: objects are small enough that the distcc round-trip is
# faster than ccache hash computation for clean builds.  ccache is useful for
# incremental rebuilds; use vostro1000-k8-ccache-no-pump.env for those.
#
# DISTCC_HOSTS is probed at source time so the env file degrades gracefully to
# localhost when the pool host is unreachable.

unset DISTCC_PUMP
unset INCLUDE_SERVER_PORT
unset INCLUDE_SERVER_ARGS
unset INCLUDE_SERVER_PID
unset CCACHE_PREFIX

# k8-sse3 flags kept here so every remote distcc compiler emits
# Turion-safe code.  -fno-emulated-tls is intentionally NOT included:
# the flag exists in clang and modern GCC, but the x86_64-pc-linux-gnu-gcc
# dispatcher used by gentoo-style distccd workers rejects it during
# meson's linker-detection probe.  K8 has native TLS support so GCC's
# default (native TLS) is already correct for the target.
export CFLAGS="-march=k8-sse3 -mtune=k8-sse3 -O2 -pipe"
export CXXFLAGS="$CFLAGS"
export LDFLAGS="-fuse-ld=lld"

_vostro_distcc_tcp_ok() {
    host="$1"
    # `getent hosts` short-circuits DNS resolution.  Without it, a slow
    # or stuck resolver can block sourcing this env file for the full
    # `nc -w1` interval per host.  This mirrors
    # vostro1000-k8-ccache-no-pump.env so the two profiles really are
    # lockstep.
    getent hosts "$host" >/dev/null 2>&1 &&
        timeout 1 bash -c ":</dev/tcp/$host/3632" >/dev/null 2>&1
}

_vostro_distcc_ssh_ok() {
    host="$1"
    # `getent hosts` before ssh so a slow resolver cannot stretch the
    # probe past the ConnectTimeout window (ConnectTimeout governs
    # the TCP connect only, not DNS).  `timeout 4` caps the worst
    # case across all SSH phases (key exchange, auth, command run)
    # to stay slightly above the ssh ConnectTimeout of 3s.
    getent hosts "$host" >/dev/null 2>&1 &&
        timeout 4 ssh -n -o BatchMode=yes -o ConnectTimeout=3 "$host" \
            'command -v distccd >/dev/null 2>&1' >/dev/null 2>&1
}

_vostro_build_distcc_hosts() {
    hosts=""
    # The x570 worker runs distccd over SSH (no TCP listener), so probe
    # it through the SSH transport.  The same probe construction is
    # used by vostro1000-k8-ccache-no-pump.env so a clean rebuild and
    # an incremental rebuild see the same mesh.
    if _vostro_distcc_ssh_ok "x570-5600X3D.local"; then
        hosts="${hosts:+$hosts }@x570-5600X3D.local/16,lzo"
    fi
    if _vostro_distcc_tcp_ok "DESKTOP-CKP9KB6.local"; then
        hosts="${hosts:+$hosts }DESKTOP-CKP9KB6.local/32,lzo"
    fi
    if [ -n "$hosts" ]; then
        printf '%s' "--randomize $hosts localhost/2,lzo"
    else
        printf '%s' "localhost/2,lzo"
    fi
}

DISTCC_HOSTS="$(_vostro_build_distcc_hosts)"
export DISTCC_HOSTS
unset -f _vostro_distcc_tcp_ok
unset -f _vostro_distcc_ssh_ok
unset -f _vostro_build_distcc_hosts

export MAKEFLAGS="-j24"
export OMP_NUM_THREADS="2"
