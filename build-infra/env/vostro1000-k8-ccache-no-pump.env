# Vostro 1000 k8 ccache-first distcc environment.
#
# Source this before configuring Mesa on the Vostro 1000.  The machine
# uses AMD Turion 64 X2 TL-66 cores, so every remote distcc compiler must
# receive k8-safe code-generation flags even when the compiler process runs
# on a newer host.

unset DISTCC_PUMP
unset INCLUDE_SERVER_PORT
unset INCLUDE_SERVER_ARGS
unset INCLUDE_SERVER_PID

export CCACHE_PREFIX="/usr/bin/distcc"
export CCACHE_PATH="/usr/bin:/usr/local/bin"
export CCACHE_DIR="$HOME/.cache/ccache"
export CCACHE_MAXSIZE="20G"

case ":${PATH}:" in
    *:/usr/local/bin:*) ;;
    *) export PATH="/usr/local/bin:${PATH}" ;;
esac

export CC="clang-21"
export CXX="clang++-21"
export LD="ld.lld-21"
export AR="llvm-ar-21"
export NM="llvm-nm-21"
export STRIP="llvm-strip-21"
export OBJCOPY="llvm-objcopy-21"

export CFLAGS="-march=k8-sse3 -mtune=k8-sse3 -O2 -pipe"
export CXXFLAGS="$CFLAGS"
export LDFLAGS="-fuse-ld=lld"

export DISTCC_HOSTS="$(
    if [ -r "$HOME/.distcc/hosts" ]; then
        awk '{
            for (host_index = 1; host_index <= NF; host_index++) {
                gsub(/,cpp/, "", $host_index)
                printf "%s%s", seen ? " " : "", $host_index
                seen++
            }
        }
        END { if (seen) printf "\n" }' "$HOME/.distcc/hosts"
    fi
)"

export MAKEFLAGS="-j8"
export OMP_NUM_THREADS="2"
