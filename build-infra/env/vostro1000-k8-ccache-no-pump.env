# Vostro 1000 k8 ccache-first distcc environment.
#
# Source this before configuring Mesa on the Vostro 1000.  The machine
# uses AMD Turion 64 X2 TL-66 cores, so every remote distcc compiler must
# receive k8-safe code-generation flags even when the compiler process runs
# on a newer host.

unset DISTCC_PUMP
unset INCLUDE_SERVER_PORT
unset INCLUDE_SERVER_ARGS
unset INCLUDE_SERVER_PID

export CCACHE_PREFIX="${CCACHE_PREFIX:-distcc}"
export CCACHE_DIR="$HOME/.cache/ccache"
export CCACHE_MAXSIZE="20G"

export CFLAGS="-march=k8-sse3 -mtune=k8-sse3 -O2 -pipe -fno-emulated-tls"
export CXXFLAGS="$CFLAGS"
export LDFLAGS="-fuse-ld=lld"

vostro1000_distcc_hosts() {
    if [ -r "$HOME/.distcc/hosts" ]; then
        awk '
        function remember_host(name) {
            if (name == "DESKTOP-CKP9KB6-2.local")
                desktop = 1;
            else if (name == "X570-5800X3D.local")
                x570 = 1;
        }
        {
            for (i = 1; i <= NF; ++i) {
                token = $i;
                if (token == "--randomize") {
                    continue;
                }
                gsub(/,cpp/, "", token);
                host = token;
                sub(/[/,].*/, "", host);
                remember_host(host);
            }
        }
        END {
            if (desktop || x570)
                print "--randomize DESKTOP-CKP9KB6-2.local/32,lzo X570-5800X3D.local/16,lzo";
        }
        ' "$HOME/.distcc/hosts"
    fi
}

DISTCC_HOSTS="$(vostro1000_distcc_hosts)"
if [ -z "$DISTCC_HOSTS" ]; then
    DISTCC_HOSTS="--randomize DESKTOP-CKP9KB6-2.local/32,lzo X570-5800X3D.local/16,lzo"
fi
export DISTCC_HOSTS
unset -f vostro1000_distcc_hosts

export MAKEFLAGS="-j16"
export OMP_NUM_THREADS="2"
