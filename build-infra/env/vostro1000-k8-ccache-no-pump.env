# Vostro 1000 k8 ccache-first distcc environment.
#
# Source this before configuring Mesa on the Vostro 1000.  The machine
# uses AMD Turion 64 X2 TL-66 cores, so every remote distcc compiler must
# receive k8-safe code-generation flags even when the compiler process runs
# on a newer host.

unset DISTCC_PUMP
unset INCLUDE_SERVER_PORT
unset INCLUDE_SERVER_ARGS
unset INCLUDE_SERVER_PID

export CCACHE_PREFIX="${CCACHE_PREFIX:-distcc}"
export CCACHE_DIR="$HOME/.cache/ccache"
export CCACHE_MAXSIZE="20G"

# -fno-emulated-tls intentionally absent: rejected by the gentoo-style
# x86_64-pc-linux-gnu-gcc dispatcher used on the distcc mesh, and K8
# supports native TLS so GCC's default is already correct.
export CFLAGS="-march=k8-sse3 -mtune=k8-sse3 -O2 -pipe"
export CXXFLAGS="$CFLAGS"
export LDFLAGS="-fuse-ld=lld"

vostro1000_distcc_host_available() {
    host="$1"
    getent hosts "$host" >/dev/null 2>&1 &&
        timeout 1 bash -c ":</dev/tcp/$host/3632" >/dev/null 2>&1
}

vostro1000_distcc_first_tcp_host() {
    for host in "$@"; do
        if vostro1000_distcc_host_available "$host"; then
            printf '%s' "$host"
            return 0
        fi
    done
    return 1
}

vostro1000_distcc_hosts() {
    hosts=""
    x570_host="$(vostro1000_distcc_first_tcp_host "x570-5600X3D" "x570-5600X3D.local" || true)"
    alienware_host="$(vostro1000_distcc_first_tcp_host "ALIENWARE.local" "ALIENWARE" || true)"

    if [ -n "$x570_host" ]; then
        hosts="${hosts:+$hosts }$x570_host/16,lzo"
    fi

    if [ -n "$alienware_host" ]; then
        hosts="${hosts:+$hosts }$alienware_host/32,lzo"
    fi

    if [ -n "$hosts" ]; then
        printf '%s\n' "--randomize $hosts"
    fi
}

DISTCC_HOSTS="$(vostro1000_distcc_hosts)"
if [ -z "$DISTCC_HOSTS" ]; then
    DISTCC_HOSTS="localhost/2,lzo"
fi
export DISTCC_HOSTS
unset -f vostro1000_distcc_host_available
unset -f vostro1000_distcc_first_tcp_host
unset -f vostro1000_distcc_hosts

export MAKEFLAGS="-j16"
export OMP_NUM_THREADS="2"
