# sapphire.env -- Apple Silicon M1/M2/M3 native env for cross-compile or
# for a native Metal/Vulkan stack build on Darwin.
# Placeholder -- fill in when a Mac build path is actually exercised.

export CC="${CC:-/opt/homebrew/opt/llvm/bin/clang}"
export CXX="${CXX:-/opt/homebrew/opt/llvm/bin/clang++}"
export CFLAGS="-mcpu=apple-m1"
export CXXFLAGS="$CFLAGS"
