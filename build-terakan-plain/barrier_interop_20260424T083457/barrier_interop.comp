#version 450
layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;
layout(push_constant) uniform Params {
    uint index_type_u32;
} pc;
layout(std430, binding = 0) writeonly buffer IndexBuffer {
    uint words[];
};

void main() {
    if (pc.index_type_u32 != 0u) {
        words[0] = 0u;
        words[1] = 1u;
        words[2] = 2u;
        words[3] = 2u;
        words[4] = 1u;
        words[5] = 3u;
    } else {
        // uint16 index stream packed into 3 dwords:
        // [0,1,2,2,1,3] -> 0x00010000, 0x00020002, 0x00030001
        words[0] = 0x00010000u;
        words[1] = 0x00020002u;
        words[2] = 0x00030001u;
    }
}
